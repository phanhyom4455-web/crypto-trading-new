// ============================================
// API 路由
// ============================================

// 获取用户列表
app.get('/api/users', async (req, res) => {
    try {
        const users = await User.findAll({
            order: [['id', 'DESC']]
        });
        res.json(users);
    } catch (error) {
        // 如果数据库没有数据，返回模拟数据
        res.json(mockData.users);
    }
});

// 删除用户
app.delete('/api/users/:id', async (req, res) => {
    try {
        await User.destroy({ where: { id: req.params.id } });
        res.json({ success: true });
    } catch (error) {
        res.status(500).json({ error: error.message });
    }
});

// 获取统计数据
app.get('/api/stats', async (req, res) => {
    try {
        let totalUsers = 0;
        let totalTransactions = 0;
        let totalOrders = 0;
        let totalRevenue = 0;
        
        try {
            totalUsers = await User.count();
            totalTransactions = await Transaction.count();
            totalOrders = await Order.count();
            const revenueResult = await Transaction.sum('amount', {
                where: { type: 'deposit', status: 'completed' }
            });
            totalRevenue = revenueResult || 0;
        } catch (dbError) {
            // 数据库没有数据时使用模拟数据
            totalUsers = mockData.dashboardStats.totalUsers;
            totalTransactions = 100;
            totalOrders = 80;
            totalRevenue = 2847560.50;
        }

        res.json({
            totalUsers: totalUsers || 15243,
            newUsers: Math.floor(Math.random() * 50) + 10,
            totalRevenue: totalRevenue || 2847560.50,
            todayRevenue: Math.floor(Math.random() * 10000) + 1000,
            totalOrders: totalOrders || 45230,
            todayOrders: Math.floor(Math.random() * 100) + 20,
            onlineUsers: Math.floor(Math.random() * 200) + 50,
            activeUsers: Math.floor(Math.random() * 500) + 100,
            apiCalls: Math.floor(Math.random() * 5000) + 1000,
            systemLoad: Math.floor(Math.random() * 30) + 10
        });
    } catch (error) {
        res.json({
            totalUsers: 15243,
            newUsers: 328,
            totalRevenue: 2847560.50,
            todayRevenue: 12580.00,
            totalOrders: 45230,
            todayOrders: 456,
            onlineUsers: 89,
            activeUsers: 320,
            apiCalls: 4567,
            systemLoad: 23
        });
    }
});

// 导出用户Excel
app.get('/admin/users/export', async (req, res) => {
    try {
        let users = [];
        try {
            users = await User.findAll();
        } catch (dbError) {
            users = mockData.users;
        }
        
        const workbook = await ExcelExporter.exportUsers(users);
        res.setHeader('Content-Type', 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet');
        res.setHeader('Content-Disposition', 'attachment; filename=users.xlsx');
        await workbook.xlsx.write(res);
        res.end();
    } catch (error) {
        res.status(500).send('导出失败: ' + error.message);
    }
});

// 导出交易Excel
app.get('/admin/transactions/export', async (req, res) => {
    try {
        let transactions = [];
        try {
            transactions = await Transaction.findAll();
        } catch (dbError) {
            transactions = mockData.transactions.map(t => ({
                id: t.id,
                user_id: 1,
                type: t.type === 'buy' ? 'trade' : 'trade',
                amount: t.total,
                method: 'USDT',
                status: t.status,
                created_at: t.time
            }));
        }
        
        const workbook = await ExcelExporter.exportTransactions(transactions);
        res.setHeader('Content-Type', 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet');
        res.setHeader('Content-Disposition', 'attachment; filename=transactions.xlsx');
        await workbook.xlsx.write(res);
        res.end();
    } catch (error) {
        res.status(500).send('导出失败: ' + error.message);
    }
});

// ============================================
// 首页重定向
// ============================================
app.get('/', (req, res) => {
    res.redirect('/admin/dashboard');
});

// ============================================
// 404处理
// ============================================
app.use((req, res) => {
    res.status(404).send(`
        <h1>404 - 页面未找到</h1>
        <p>您访问的页面不存在</p>
        <a href="/admin/dashboard">返回控制台</a>
    `);
});

// ============================================
// 错误处理
// ============================================
app.use((err, req, res, next) => {
    console.error('❌ 错误:', err.stack);
    res.status(500).send(`
        <h1>500 - 服务器错误</h1>
        <p>${err.message}</p>
        <a href="/admin/dashboard">返回控制台</a>
    `);
});

// ============================================
// 创建HTTP服务器并集成Socket.IO
// ============================================
const server = http.createServer(app);
const io = socketIo(server, {
    cors: { origin: '*' }
});

// Socket.IO 实时更新
io.on('connection', (socket) => {
    console.log('🔌 客户端已连接');
    
    // 每3秒发送一次更新
    const interval = setInterval(() => {
        socket.emit('stats-update', {
            onlineUsers: Math.floor(Math.random() * 200) + 50,
            todayTransactions: Math.floor(Math.random() * 100) + 50,
            apiCalls: Math.floor(Math.random() * 5000) + 1000,
            systemLoad: Math.floor(Math.random() * 30) + 10
        });
    }, 3000);
    
    socket.on('disconnect', () => {
        clearInterval(interval);
        console.log('🔌 客户端断开');
    });
});

// ============================================
// 启动服务器
// ============================================
server.listen(PORT, () => {
    console.log('========================================');
    console.log('🚀 管理后台已启动');
    console.log(`📱 访问地址: http://localhost:${PORT}`);
    console.log(`🔑 默认账号: admin`);
    console.log(`🔑 默认密码: password`);
    console.log(`📁 项目路径: ${__dirname}`);
    console.log('========================================');
});