<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            background: #f0f2f5;
            min-height: 100vh;
            padding-bottom: 80px;
        }
        .header {
            background: white;
            padding: 16px 20px;
            display: flex;
            align-items: center;
            border-bottom: 1px solid #e8ecf1;
        }
        .header .back { text-decoration: none; font-size: 24px; margin-right: 16px; color: #1a1a2e; }
        .header h2 { font-size: 20px; color: #1a1a2e; }
        .container { max-width: 480px; margin: 0 auto; padding: 16px; }
        .card {
            background: white;
            border-radius: 20px;
            padding: 16px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.06);
        }
        .record-item {
            padding: 12px 16px;
            border-bottom: 1px solid #f0f2f5;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .record-item:last-child { border-bottom: none; }
        .record-item .left { display: flex; flex-direction: column; }
        .record-item .left .amount { font-weight: 700; font-size: 16px; }
        .record-item .left .time { font-size: 12px; color: #999; }
        .record-item .status {
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 600;
        }
        .status.pending { background: #fef9e7; color: #7d6608; }
        .status.completed { background: #e8f8f0; color: #27ae60; }
        .status.rejected { background: #fee; color: #e74c3c; }
        .empty { text-align: center; color: #999; padding: 40px 0; }
        .bottom-nav {
            position: fixed;
            bottom: 0;
            left: 0;
            right: 0;
            background: white;
            display: flex;
            justify-content: space-around;
            padding: 8px 0;
            border-top: 1px solid #e8ecf1;
            max-width: 480px;
            margin: 0 auto;
        }
        .bottom-nav a {
            text-decoration: none;
            color: #888;
            font-size: 12px;
            text-align: center;
            padding: 4px 0;
            flex: 1;
        }
        .bottom-nav a .icon { font-size: 22px; display: block; }
        .bottom-nav a.active { color: #667eea; }
        .tabs { display: flex; margin-bottom: 16px; gap: 8px; }
        .tabs a {
            flex: 1;
            text-align: center;
            padding: 10px;
            background: white;
            border-radius: 12px;
            text-decoration: none;
            color: #888;
            font-weight: 600;
            font-size: 14px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.06);
        }
        .tabs a.active { background: #667eea; color: white; }
    </style>
</head>
<body>
    <div class="header">
        <a href="/dashboard" class="back">‹</a>
        <h2><%= title %></h2>
    </div>

    <div class="container">
        <div class="tabs">
            <a href="/deposit-records" class="<%= type === 'deposit' ? 'active' : '' %>">充值记录</a>
            <a href="/withdraw-records" class="<%= type === 'withdraw' ? 'active' : '' %>">取款记录</a>
        </div>

        <div class="card">
            <% if (records && records.length > 0) { %>
                <% records.forEach(record => { %>
                    <div class="record-item">
                        <div class="left">
                            <span class="amount"><%= record.amount %> USDT</span>
                            <span class="time"><%= new Date(record.created_at).toLocaleString() %></span>
                        </div>
                        <span class="status <%= record.status %>">
                            <%= record.status === 'pending' ? '审核中' : record.status === 'completed' ? '已完成' : '已驳回' %>
                        </span>
                    </div>
                <% }) %>
            <% } else { %>
                <div class="empty">暂无记录</div>
            <% } %>
        </div>
    </div>

    <div class="bottom-nav">
        <a href="/dashboard"><span class="icon">🏠</span>首页</a>
        <a href="/trade"><span class="icon">📈</span>交易</a>
        <a href="/deposit"><span class="icon">💰</span>充值</a>
        <a href="/withdraw"><span class="icon">🏦</span>取款</a>
        <a href="/settings"><span class="icon">⚙️</span>设置</a>
    </div>
</body>
</html>