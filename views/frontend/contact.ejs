    <link href="https://cdn.bootcdn.net/ajax/libs/twitter-bootstrap/5.3.0/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.bootcdn.net/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <style>
        body { font-family: 'Segoe UI', sans-serif; padding-top: 70px; background: #f8f9fa; }
        .navbar { background: linear-gradient(135deg, #667eea, #764ba2); padding: 15px 0; box-shadow: 0 4px 20px rgba(102,126,234,0.3); }
        .navbar-brand, .nav-link { color: #fff !important; }
        .nav-link:hover { opacity: 0.8; }
        .footer { background: #1a202c; color: rgba(255,255,255,0.7); padding: 40px 0; margin-top: 50px; }
        .footer a { color: rgba(255,255,255,0.6); text-decoration: none; }
        .footer a:hover { color: #fff; }
        .contact-card { background: #fff; border-radius: 16px; padding: 30px; box-shadow: 0 4px 20px rgba(0,0,0,0.06); height: 100%; }
        .contact-card .icon { width: 60px; height: 60px; border-radius: 50%; background: linear-gradient(135deg, #667eea, #764ba2); display: flex; align-items: center; justify-content: center; margin-bottom: 15px; color: #fff; font-size: 24px; }
        .section-title { text-align: center; margin-bottom: 40px; }
        .section-title h2 { font-size: 36px; font-weight: 800; }
        .section-title p { color: #6b7280; }
        .form-control { border-radius: 10px; padding: 12px 16px; border: 2px solid #e5e7eb; }
        .form-control:focus { border-color: #667eea; box-shadow: 0 0 0 3px rgba(102,126,234,0.2); }
        .btn-submit { background: linear-gradient(135deg, #667eea, #764ba2); border: none; border-radius: 10px; padding: 12px; font-weight: 600; color: #fff; width: 100%; }
        .btn-submit:hover { transform: translateY(-2px); box-shadow: 0 8px 25px rgba(102,126,234,0.4); }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg fixed-top">
        <div class="container">
            <a class="navbar-brand" href="/"><i class="fas fa-coins me-2"></i>CoinTrade</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item"><a class="nav-link" href="/">首页</a></li>
                    <li class="nav-item"><a class="nav-link" href="/market">行情</a></li>
                    <li class="nav-item"><a class="nav-link" href="/deposit">充值</a></li>
                    <li class="nav-item"><a class="nav-link" href="/withdraw">提现</a></li>
                    <li class="nav-item"><a class="nav-link" href="/help">帮助</a></li>
                    
                    <li class="nav-item"><a class="nav-link" href="/login">登录</a></li>
                    <li class="nav-item"><a class="nav-link btn btn-light text-primary px-4 rounded-pill" href="/register">注册</a></li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="container py-5">
        <div class="section-title">
            <h2>联系我们</h2>
            <p>我们随时准备为您服务</p>
        </div>
        <div class="row g-4">
            <div class="col-lg-6">
                <div class="contact-card">
                    <h5 class="fw-bold mb-4">发送消息</h5>
                    <div class="mb-3">
                        <label class="fw-bold">姓名</label>
                        <input type="text" class="form-control" placeholder="请输入您的姓名">
                    </div>
                    <div class="mb-3">
                        <label class="fw-bold">邮箱</label>
                        <input type="email" class="form-control" placeholder="请输入您的邮箱">
                    </div>
                    <div class="mb-3">
                        <label class="fw-bold">消息</label>
                        <textarea class="form-control" rows="4" placeholder="请输入您的消息"></textarea>
                    </div>
                    <button class="btn-submit"><i class="fas fa-paper-plane me-2"></i>发送消息</button>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="contact-card">
                    <h5 class="fw-bold mb-4">联系方式</h5>
                    <div class="d-flex mb-3">
                        <div class="icon"><i class="fas fa-phone"></i></div>
                        <div><h6 class="fw-bold mb-0">客服电话</h6><p class="text-muted">+86 400-888-8888</p></div>
                    </div>
                    <div class="d-flex mb-3">
                        <div class="icon"><i class="fas fa-envelope"></i></div>
                        <div><h6 class="fw-bold mb-0">邮箱地址</h6><p class="text-muted">support@cointrade.com</p></div>
                    </div>
                    <div class="d-flex mb-3">
                        <div class="icon"><i class="fas fa-clock"></i></div>
                        <div><h6 class="fw-bold mb-0">工作时间</h6><p class="text-muted">24小时在线服务</p></div>
                    </div>
                    <div class="d-flex">
                        <div class="icon"><i class="fas fa-map-marker-alt"></i></div>
                        <div><h6 class="fw-bold mb-0">公司地址</h6><p class="text-muted">中国 · 深圳 · 南山科技园</p></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <footer class="footer">
        <div class="container">
            <div class="row g-4">
