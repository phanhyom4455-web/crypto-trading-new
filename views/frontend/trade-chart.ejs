<!-- ============================================ -->
<!-- TradingView 真实K线图 -->
<!-- ============================================ -->
<style>
.tv-chart-container {
    height: 350px;
    border-radius: 12px;
    overflow: hidden;
    background: #1e222d;
}
</style>

<div class="tv-chart-container">
    <div id="tradingview_chart" style="height:100%;width:100%;"></div>
</div>

<script type="text/javascript" src="https://s3.tradingview.com/tv.js"></script>
<script type="text/javascript">
(function() {
    var tvSymbols = {
        'BTC/USDT': 'BITSTAMP:BTCUSD',
        'ETH/USDT': 'BITSTAMP:ETHUSD',
        'ADA/USDT': 'BINANCE:ADAUSDT',
        'DOT/USDT': 'BINANCE:DOTUSDT'
    };

    var currentTvSymbol = 'BITSTAMP:BTCUSD';

    function loadTVChart(symbol) {
        var container = document.getElementById('tradingview_chart');
        if (!container) return;
        container.innerHTML = '';

        new TradingView.widget({
            "width": "100%",
            "height": 350,
            "symbol": symbol,
            "interval": "60",
            "timezone": "Asia/Shanghai",
            "theme": "dark",
            "style": "1",
            "locale": "zh_CN",
            "toolbar_bg": "#1e222d",
            "enable_publishing": false,
            "hide_side_toolbar": true,
            "allow_symbol_change": false,
            "save_image": false,
            "container_id": "tradingview_chart",
            "studies": [
                "MASimple@tv-basicstudies"
            ]
        });
    }

    // 页面加载后初始化
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', function() {
            loadTVChart(currentTvSymbol);
        });
    } else {
        loadTVChart(currentTvSymbol);
    }

    // 暴露给外部调用
    window.updateTVChart = function(pair) {
        var symbol = tvSymbols[pair] || 'BITSTAMP:BTCUSD';
        currentTvSymbol = symbol;
        loadTVChart(symbol);
    };
})();
</script>