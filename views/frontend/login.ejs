<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>登录 - 数字货币交易平台</title>
    <link href="https://cdn.bootcdn.net/ajax/libs/twitter-bootstrap/5.3.0/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.bootcdn.net/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
            background: #0a0e17;
            position: relative;
            overflow: hidden;
        }
        /* 背景动画 - 数字货币K线图风格 */
        .bg-grid {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background-image: 
                linear-gradient(rgba(102, 126, 234, 0.03) 1px, transparent 1px),
                linear-gradient(90deg, rgba(102, 126, 234, 0.03) 1px, transparent 1px);
            background-size: 50px 50px;
            z-index: 0;
        }
        .bg-chart {
            position: fixed;
            bottom: 0;
            left: 0;
            right: 0;
            height: 200px;
            z-index: 0;
            opacity: 0.15;
        }
        .bg-chart svg {
            width: 100%;
            height: 100%;
        }
        .bg-particles {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            z-index: 0;
            overflow: hidden;
        }
        .bg-particles span {
            position: absolute;
            width: 3px;
            height: 3px;
            background: rgba(102, 126, 234, 0.4);
            border-radius: 50%;
            animation: float 15s infinite;
        }
        @keyframes float {
            0%, 100% { transform: translateY(0) translateX(0); opacity: 0; }
            10% { opacity: 1; }
            90% { opacity: 1; }
            100% { transform: translateY(-100vh) translateX(50px); opacity: 0; }
        }

        /* 主容器 */
        .login-wrapper {
            position: relative;
            z-index: 1;
            display: flex;
            width: 100%;
            max-width: 1100px;
            min-height: 600px;
            background: rgba(255,255,255,0.04);
            backdrop-filter: blur(20px);
            border-radius: 24px;
            border: 1px solid rgba(255,255,255,0.06);
            box-shadow: 0 50px 100px rgba(0,0,0,0.5), inset 0 1px 0 rgba(255,255,255,0.05);
            overflow: hidden;
        }

        /* 左侧品牌区域 */
        .brand-section {
            flex: 1;
            padding: 50px 40px;
            background: linear-gradient(135deg, rgba(102, 126, 234, 0.15), rgba(118, 75, 162, 0.10));
            display: flex;
            flex-direction: column;
            justify-content: center;
            position: relative;
            min-height: 500px;
        }
        .brand-section .logo {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 40px;
        }
        .brand-section .logo i {
            font-size: 32px;
            color: #667eea;
            background: rgba(102, 126, 234, 0.15);
            padding: 12px;
            border-radius: 14px;
        }
        .brand-section .logo h1 {
            font-size: 28px;
            font-weight: 800;
            color: #fff;
            margin: 0;
        }
        .brand-section .logo h1 span {
            color: #667eea;
        }
        .brand-section .logo small {
            color: rgba(255,255,255,0.4);
            font-size: 12px;
            font-weight: 400;
        }
        .brand-section h2 {
            font-size: 36px;
            font-weight: 800;
            color: #fff;
            margin-bottom: 16px;
            line-height: 1.2;
        }
        .brand-section h2 span {
            background: linear-gradient(135deg, #667eea, #764ba2);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }
        .brand-section p {
            color: rgba(255,255,255,0.5);
            font-size: 16px;
            line-height: 1.8;
            max-width: 400px;
        }

        /* 实时价格小部件 */
        .price-widget {
            display: flex;
            gap: 15px;
            margin-top: 30px;
            flex-wrap: wrap;
        }
        .price-widget .item {
            background: rgba(255,255,255,0.05);
            border-radius: 12px;
            padding: 12px 18px;
            border: 1px solid rgba(255,255,255,0.04);
            min-width: 100px;
        }
        .price-widget .item .label {
            color: rgba(255,255,255,0.3);
            font-size: 11px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
        .price-widget .item .value {
            color: #fff;
            font-weight: 700;
            font-size: 18px;
            margin-top: 2px;
        }
        .price-widget .item .change {
            font-size: 13px;
            font-weight: 600;
        }
        .price-widget .item .change.up { color: #10b981; }
        .price-widget .item .change.down { color: #ef4444; }

        /* 右侧登录表单 */
        .form-section {
            width: 420px;
            padding: 50px 40px;
            background: rgba(255,255,255,0.02);
            display: flex;
            flex-direction: column;
            justify-content: center;
        }
        .form-section .form-title {
            color: #fff;
            font-size: 24px;
            font-weight: 700;
            margin-bottom: 6px;
        }
        .form-section .form-subtitle {
            color: rgba(255,255,255,0.4);
            font-size: 14px;
            margin-bottom: 30px;
        }
        .form-section .form-control {
            background: rgba(255,255,255,0.06);
            border: 1px solid rgba(255,255,255,0.08);
            border-radius: 12px;
            padding: 14px 18px;
            color: #fff;
            font-size: 14px;
        }
        .form-section .form-control:focus {
            background: rgba(255,255,255,0.08);
            border-color: #667eea;
            box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.15);
        }
        .form-section .form-control::placeholder {
            color: rgba(255,255,255,0.25);
        }
        .form-section .input-group-text {
            background: rgba(255,255,255,0.06);
            border: 1px solid rgba(255,255,255,0.08);
            border-right: none;
            color: rgba(255,255,255,0.3);
            border-radius: 12px 0 0 12px;
        }
        .form-section .form-control-with-icon {
            border-left: none;
            border-radius: 0 12px 12px 0;
        }
        .form-section .form-label {
            color: rgba(255,255,255,0.7);
            font-weight: 600;
            font-size: 13px;
        }
        .form-section .form-check-label {
            color: rgba(255,255,255,0.4);
            font-size: 13px;
        }
        .form-section .form-check-input:checked {
            background-color: #667eea;
            border-color: #667eea;
        }
        .form-section .btn-login {
            background: linear-gradient(135deg, #667eea, #764ba2);
            border: none;
            border-radius: 12px;
            padding: 14px;
            font-weight: 700;
            font-size: 16px;
            color: #fff;
            width: 100%;
            transition: all 0.3s;
        }
        .form-section .btn-login:hover {
            transform: translateY(-2px);
            box-shadow: 0 12px 40px rgba(102, 126, 234, 0.3);
        }
        .form-section .btn-login:disabled {
            opacity: 0.6;
            cursor: not-allowed;
        }
        .form-section .text-link {
            color: #667eea;
            text-decoration: none;
            font-weight: 600;
        }
        .form-section .text-link:hover {
            text-decoration: underline;
        }
        .form-section .divider {
            display: flex;
            align-items: center;
            gap: 15px;
            margin: 20px 0;
            color: rgba(255,255,255,0.15);
            font-size: 12px;
        }
        .form-section .divider::before,
        .form-section .divider::after {
            content: '';
            flex: 1;
            height: 1px;
            background: rgba(255,255,255,0.06);
        }
        .form-section .social-login {
            display: flex;
            gap: 10px;
        }
        .form-section .social-login .btn {
            flex: 1;
            padding: 10px;
            border-radius: 12px;
            background: rgba(255,255,255,0.04);
            border: 1px solid rgba(255,255,255,0.06);
            color: rgba(255,255,255,0.5);
            transition: all 0.3s;
        }
        .form-section .social-login .btn:hover {
            background: rgba(255,255,255,0.08);
            color: #fff;
        }
        .form-section .alert {
            border-radius: 12px;
            padding: 12px 16px;
            font-size: 14px;
        }
        .form-section .alert-danger {
            background: rgba(239, 68, 68, 0.12);
            color: #ef4444;
            border: 1px solid rgba(239, 68, 68, 0.15);
        }
        .form-section .alert-success {
            background: rgba(16, 185, 129, 0.12);
            color: #10b981;
            border: 1px solid rgba(16, 185, 129, 0.15);
        }
        .form-section .alert-info {
            background: rgba(59, 130, 246, 0.12);
            color: #3b82f6;
            border: 1px solid rgba(59, 130, 246, 0.15);
        }
        .spinner { display: none; }
        .btn-login.loading .spinner { display: inline-block; }
        .btn-login.loading .btn-text { display: none; }

        /* 2FA 区域 */
        #twofaSection { display: none; }

        /* 响应式 */
        @media (max-width: 992px) {
            .brand-section { display: none; }
            .form-section { width: 100%; max-width: 440px; margin: 0 auto; }
            .login-wrapper { background: rgba(10, 14, 23, 0.95); }
        }
        @media (max-width: 480px) {
            .form-section { padding: 30px 20px; }
            .price-widget .item { min-width: 80px; padding: 10px 14px; }
            .price-widget .item .value { font-size: 15px; }
        }
    </style>
</head>
<body>

    <!-- 背景装饰 -->
    <div class="bg-grid"></div>
    <div class="bg-particles">
        <span style="left:5%; animation-delay:0s;"></span>
        <span style="left:15%; animation-delay:2s;"></span>
        <span style="left:25%; animation-delay:4s;"></span>
        <span style="left:35%; animation-delay:1s;"></span>
        <span style="left:45%; animation-delay:3s;"></span>
        <span style="left:55%; animation-delay:5s;"></span>
        <span style="left:65%; animation-delay:0.5s;"></span>
        <span style="left:75%; animation-delay:2.5s;"></span>
        <span style="left:85%; animation-delay:4.5s;"></span>
        <span style="left:95%; animation-delay:1.5s;"></span>
    </div>

    <!-- K线图背景 -->
    <div class="bg-chart">
        <svg viewBox="0 0 1200 200" preserveAspectRatio="none">
            <polyline points="0,160 50,140 100,170 150,120 200,150 250,80 300,110 350,60 400,90 450,40 500,70 550,130 600,100 650,150 700,80 750,120 800,50 850,90 900,140 950,100 1000,160 1050,120 1100,70 1150,130 1200,80" 
                stroke="#667eea" stroke-width="2" fill="none" opacity="0.3"/>
            <polyline points="0,180 50,160 100,190 150,140 200,170 250,100 300,130 350,80 400,110 450,60 500,90 550,150 600,120 650,170 700,100 750,140 800,70 850,110 900,160 950,120 1000,180 1050,140 1100,90 1150,150 1200,100" 
                stroke="#764ba2" stroke-width="2" fill="none" opacity="0.2"/>
        </svg>
    </div>

    <!-- 主容器 -->
    <div class="login-wrapper">
        <!-- 左侧品牌 -->
        <div class="brand-section">
            <div class="logo">
                <i class="fas fa-coins"></i>
                <div>
                    <h1>Coin<span>Trade</span></h1>
                    <small>数字货币交易平台</small>
                </div>
            </div>
            <h2>安全、<span>智能</span>、<br>专业的数字资产交易</h2>
            <p>实时行情 · 毫秒交易 · 顶级安全 · 7x24小时服务</p>

            <!-- 实时价格 -->
            <div class="price-widget">
                <div class="item">
                    <div class="label">BTC/USDT</div>
                    <div class="value">$62,450</div>
                    <div class="change up">▲ +2.35%</div>
                </div>
                <div class="item">
                    <div class="label">ETH/USDT</div>
                    <div class="value">$2,450</div>
                    <div class="change down">▼ -1.20%</div>
                </div>
                <div class="item">
                    <div class="label">ADA/USDT</div>
                    <div class="value">$0.452</div>
                    <div class="change up">▲ +5.60%</div>
                </div>
            </div>
        </div>

        <!-- 右侧表单 -->
        <div class="form-section">
            <h3 class="form-title" id="loginTitle">欢迎回来</h3>
            <p class="form-subtitle" id="loginSubtitle">登录您的交易账户</p>

            <div id="message" style="display: none;" class="alert mb-3"></div>

            <!-- 登录表单 -->
            <form id="loginForm" onsubmit="handleLogin(event)">
                <div class="mb-3">
                    <label class="form-label">用户名</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="fas fa-user"></i></span>
                        <input type="text" class="form-control form-control-with-icon" id="username" placeholder="请输入用户名" required>
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label">密码</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="fas fa-lock"></i></span>
                        <input type="password" class="form-control form-control-with-icon" id="password" placeholder="请输入密码" required>
                    </div>
                </div>
                <div class="mb-3 d-flex justify-content-between">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="remember">
                        <label class="form-check-label" for="remember">记住我</label>
                    </div>
                    <a href="/support" target="_blank" class="forgot-password">忘记密码？联系客服</a>
                </div>
                <button type="submit" class="btn-login" id="loginBtn">
                    <span class="spinner"><i class="fas fa-spinner fa-spin"></i></span>
                    <span class="btn-text"><i class="fas fa-sign-in-alt me-2"></i>登录</span>
                </button>
            </form>

            <!-- 2FA验证 -->
            <form id="twofaForm" style="display: none;" onsubmit="handle2FA(event)">
                <div id="twofaSection">
                    <div class="alert alert-info mb-3">
                        <i class="fas fa-shield-alt me-2"></i>
                        请输入您的 Google Authenticator 验证码
                    </div>
                    <div class="mb-3">
                        <label class="form-label">6位验证码</label>
                        <input type="text" class="form-control" id="twofaCode" placeholder="输入6位数字验证码" maxlength="6" inputmode="numeric" style="text-align:center;font-size:24px;letter-spacing:6px;">
                    </div>
                    <button type="submit" class="btn-login" id="twofaBtn">
                        <span class="spinner"><i class="fas fa-spinner fa-spin"></i></span>
                        <span class="btn-text"><i class="fas fa-shield-alt me-2"></i>验证</span>
                    </button>
                    <div class="text-center mt-3">
                        <button type="button" class="btn btn-link text-link" onclick="backToLogin()" style="font-size:13px;">
                            <i class="fas fa-arrow-left me-1"></i>返回登录
                        </button>
                    </div>
                </div>
            </form>

            <div class="divider">或</div>

            <div class="social-login">
                <button class="btn" onclick="useBiometric('fingerprint')">
                    <i class="fas fa-fingerprint fa-lg"></i>
                </button>
                <button class="btn" onclick="useBiometric('face')">
                    <i class="fas fa-face-smile fa-lg"></i>
                </button>
                <button class="btn" onclick="useDemoAccount()">
                    <i class="fas fa-user-secret fa-lg"></i>
                </button>
            </div>

            <div class="text-center mt-3">
                <span style="color:rgba(255,255,255,0.3);font-size:14px;">还没有账号？</span>
                <a href="/register" class="text-link">立即注册</a>
            </div>
            <div class="text-center mt-2">
                <span style="color:rgba(255,255,255,0.15);font-size:11px;">演示账号: admin / password</span>
            </div>
        </div>
    </div>

    <script src="https://cdn.bootcdn.net/ajax/libs/twitter-bootstrap/5.3.0/js/bootstrap.bundle.min.js"></script>
    <script>
        let tempUser = null;

        function showMessage(message, type) {
            const msg = document.getElementById('message');
            msg.style.display = 'block';
            msg.textContent = message;
            msg.className = 'alert mb-3 ' + (type === 'success' ? 'alert-success' : type === 'info' ? 'alert-info' : 'alert-danger');
            setTimeout(() => { msg.style.display = 'none'; }, 5000);
        }

        function useBiometric(type) {
            const name = type === 'fingerprint' ? '指纹' : '面容';
            showMessage(`🔍 请使用${name}验证...`, 'info');
            setTimeout(() => {
                document.getElementById('username').value = 'admin';
                document.getElementById('password').value = 'password';
                handleLogin(new Event('submit'));
            }, 1200);
        }

        function useDemoAccount() {
            document.getElementById('username').value = 'admin';
            document.getElementById('password').value = 'password';
            showMessage('✅ 已填充演示账号', 'success');
        }

        async function handleLogin(event) {
            event.preventDefault();

            const username = document.getElementById('username').value.trim();
            const password = document.getElementById('password').value;
            const btn = document.getElementById('loginBtn');

            if (!username || !password) {
                showMessage('请输入用户名和密码', 'error');
                return;
            }

            btn.classList.add('loading');
            btn.disabled = true;
            document.getElementById('message').style.display = 'none';

            try {
                const response = await fetch('/api/login', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ username, password })
                });
                const data = await response.json();

                if (data.success) {
                    if (data.require2fa) {
                        tempUser = data.user;
                        document.getElementById('loginForm').style.display = 'none';
                        document.getElementById('twofaForm').style.display = 'block';
                        document.getElementById('loginTitle').textContent = '两步验证';
                        document.getElementById('loginSubtitle').textContent = '输入验证码完成登录';
                        showMessage('📱 请输入 Google Authenticator 验证码', 'info');
                    } else {
                        showMessage('✅ 登录成功！', 'success');
                        setTimeout(() => { window.location.href = '/'; }, 1000);
                    }
                } else {
                    showMessage(data.message || '登录失败', 'error');
                }
            } catch (error) {
                showMessage('网络错误，请重试', 'error');
            } finally {
                btn.classList.remove('loading');
                btn.disabled = false;
            }
        }

        async function handle2FA(event) {
            event.preventDefault();

            const code = document.getElementById('twofaCode').value.trim();
            const btn = document.getElementById('twofaBtn');

            if (!code || code.length < 6) {
                showMessage('请输入6位验证码', 'error');
                return;
            }

            btn.classList.add('loading');
            btn.disabled = true;

            try {
                const response = await fetch('/api/verify-2fa-login', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ userId: tempUser ? tempUser.id : null, code })
                });
                const data = await response.json();

                if (data.success) {
                    showMessage('✅ 验证成功！', 'success');
                    setTimeout(() => { window.location.href = '/'; }, 1000);
                } else {
                    showMessage(data.message || '验证码错误', 'error');
                }
            } catch (error) {
                showMessage('网络错误，请重试', 'error');
            } finally {
                btn.classList.remove('loading');
                btn.disabled = false;
            }
        }

        function backToLogin() {
            document.getElementById('loginForm').style.display = 'block';
            document.getElementById('twofaForm').style.display = 'none';
            document.getElementById('loginTitle').textContent = '欢迎回来';
            document.getElementById('loginSubtitle').textContent = '登录您的交易账户';
            document.getElementById('twofaCode').value = '';
        }
    </script>
<!-- 实时价格滚动条 -->
<div style="position: fixed; bottom: 20px; left: 0; right: 0; background: rgba(0,0,0,0.8); padding: 10px 0; z-index: 1000;">
    <marquee behavior="scroll" direction="left" style="color: #10b981; font-size: 14px;">
        BTC/USDT $62,450 ▲+2.35% | ETH/USDT $2,450 ▼-1.20% | ADA/USDT $0.452 ▲+5.60% | DOT/USDT $6.250 ▲+3.80% | SOL/USDT $25.80 ▲+4.20% | AVAX/USDT $14.20 ▲+6.80%
    </marquee>
</div>
</body>
</html>