<!-- ============================================ -->
<!-- TradingView 真实K线图（行情页） -->
<!-- ============================================ -->
<style>
.tv-chart-container {
    height: 450px;
    border-radius: 12px;
    overflow: hidden;
    background: #1e222d;
}
</style>

<div class="tv-chart-container">
    <div id="tradingview_market_chart" style="height:100%;width:100%;"></div>
</div>

<script type="text/javascript" src="https://s3.tradingview.com/tv.js"></script>
<script type="text/javascript">
(function() {
    var currentInterval = '60';
    var currentSymbol = 'BITSTAMP:BTCUSD';

    function loadMarketChart(interval, symbol) {
        var container = document.getElementById('tradingview_market_chart');
        if (!container) return;
        container.innerHTML = '';

        new TradingView.widget({
            "width": "100%",
            "height": 450,
            "symbol": symbol,
            "interval": interval,
            "timezone": "Asia/Shanghai",
            "theme": "dark",
            "style": "1",
            "locale": "zh_CN",
            "toolbar_bg": "#1e222d",
            "enable_publishing": false,
            "hide_side_toolbar": false,
            "allow_symbol_change": true,
            "save_image": false,
            "container_id": "tradingview_market_chart",
            "studies": [
                "MASimple@tv-basicstudies",
                "RSI@tv-basicstudies"
            ]
        });
    }

    // 页面加载
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', function() {
            loadMarketChart(currentInterval, currentSymbol);
        });
    } else {
        loadMarketChart(currentInterval, currentSymbol);
    }

    // 切换周期（1H / 1D / 1W / 1M）
    window.updateTVInterval = function(interval) {
        currentInterval = interval;
        loadMarketChart(currentInterval, currentSymbol);
    };

    // 切换币种
    window.updateTVSymbol = function(symbol) {
        currentSymbol = symbol;
        loadMarketChart(currentInterval, currentSymbol);
    };
})();
</script>