<!-- 2. 实时价格跳动 -->
<!-- ============================================ -->
<script>
// 模拟实时价格数据
const realtimePrices = [
    { id: 'btc', pair: 'BTC/USDT', price: 62450, change: 2.35, volume: '12.5K BTC' },
    { id: 'eth', pair: 'ETH/USDT', price: 2450, change: -1.20, volume: '45.2K ETH' },
    { id: 'ada', pair: 'ADA/USDT', price: 0.452, change: 5.60, volume: '1.2M ADA' },
    { id: 'dot', pair: 'DOT/USDT', price: 6.25, change: 3.80, volume: '85K DOT' },
    { id: 'sol', pair: 'SOL/USDT', price: 25.80, change: 4.20, volume: '120K SOL' },
    { id: 'avax', pair: 'AVAX/USDT', price: 14.20, change: 6.80, volume: '65K AVAX' }
];

function updateRealtimePrices() {
    realtimePrices.forEach(p => {
        // 随机波动
        p.price += (Math.random() - 0.5) * p.price * 0.003;
        p.change += (Math.random() - 0.5) * 0.08;
        p.volume = (parseFloat(p.volume) * (1 + Math.random() * 0.01)).toFixed(2) + ' ' + p.volume.split(' ')[1];
        
        // 更新价格
        const priceEl = document.getElementById('price-' + p.id);
        if (priceEl) {
            priceEl.textContent = '$' + p.price.toFixed(p.price < 1 ? 4 : 2);
        }
        
        // 更新涨跌幅
        const changeEl = document.getElementById('change-' + p.id);
        if (changeEl) {
            changeEl.textContent = (p.change >= 0 ? '▲+' : '▼') + Math.abs(p.change).toFixed(2) + '%';
            changeEl.className = 'change ' + (p.change >= 0 ? 'up' : 'down');
        }
        
        // 更新成交量
        const volumeEl = document.getElementById('volume-' + p.id);
        if (volumeEl) {
            volumeEl.textContent = '24h: ' + p.volume;
        }
    });
}

// 每3秒更新
setInterval(updateRealtimePrices, 3000);

// 初始化
updateRealtimePrices();
</script>

