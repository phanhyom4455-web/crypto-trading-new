<script>
// 交易对切换
function switchPair(pair) {
    const pairData = {
        'BTC/USDT': [62000, 62500, 61800, 62450, 62450, 62800, 62200, 62600, 62600, 63200, 62500, 63000, 63000, 63500, 62800, 63300, 63300, 63800, 63100, 63500],
        'ETH/USDT': [2400, 2450, 2380, 2430, 2430, 2480, 2410, 2450, 2450, 2500, 2420, 2470, 2470, 2520, 2440, 2480, 2480, 2530, 2450, 2490],
        'ADA/USDT': [0.44, 0.45, 0.43, 0.452, 0.452, 0.46, 0.44, 0.455, 0.455, 0.47, 0.45, 0.465, 0.465, 0.48, 0.46, 0.475, 0.475, 0.49, 0.47, 0.485],
        'DOT/USDT': [6.0, 6.1, 5.95, 6.05, 6.05, 6.15, 6.0, 6.1, 6.1, 6.2, 6.05, 6.15, 6.15, 6.3, 6.1, 6.2, 6.2, 6.35, 6.15, 6.25]
    };
    
    const data = pairData[pair] || pairData['BTC/USDT'];
    
    // 更新K线图
    if (typeof myChart !== 'undefined') {
        myChart.setOption({
            series: [{
                data: data.map((price, i) => [
                    price - 100, price + 50, price - 150, price
                ])
            }]
        });
    }
    
    // 更新当前交易对标题
    const titleEl = document.getElementById('currentPair');
    if (titleEl) {
        titleEl.textContent = pair + ' 走势图';
    }
    
    // 更新按钮状态
    document.querySelectorAll('.pair-btn').forEach(btn => btn.classList.remove('active'));
    document.getElementById('btn-' + pair.replace('/', '-')).classList.add('active');
}
</script>

