<style>
.lang-switcher {
    position: fixed;
    top: 80px;
    right: 20px;
    z-index: 999;
    display: flex;
    gap: 5px;
}
.lang-switcher button {
    padding: 5px 10px;
    border: 1px solid #ddd;
    background: #fff;
    border-radius: 5px;
    cursor: pointer;
    font-size: 12px;
}
.lang-switcher button.active {
    background: #667eea;
    color: #fff;
    border-color: #667eea;
}
</style>

<div class="lang-switcher">
    <button onclick="setLang('zh')" class="active">中文</button>
    <button onclick="setLang('en')">EN</button>
    <button onclick="setLang('lo')">ລາວ</button>
</div>

<script>
function setLang(lang) {
    // 更新按钮状态
    document.querySelectorAll('.lang-switcher button').forEach(btn => btn.classList.remove('active'));
    event.target.classList.add('active');
    
    // 简单翻译
    const translations = {
        zh: { home: '首页', market: '行情', trade: '交易', deposit: '充值', withdraw: '提现' },
        en: { home: 'Home', market: 'Market', trade: 'Trade', deposit: 'Deposit', withdraw: 'Withdraw' },
        lo: { home: 'ໜ້າຫຼັກ', market: 'ຕະຫຼາດ', trade: 'ຊື້ຂາຍ', deposit: 'ຝາກເງິນ', withdraw: 'ຖອນເງິນ' }
    };
    
    const t = translations[lang];
    if (t) {
        const navLinks = document.querySelectorAll('.navbar-nav .nav-link');
        if (navLinks.length >= 5) {
            navLinks[0].textContent = t.home;
            navLinks[1].textContent = t.market;
            navLinks[2].textContent = t.trade;
            navLinks[3].textContent = t.deposit;
            navLinks[4].textContent = t.withdraw;
        }
    }
}
</script>

