    font-weight: 600;
}
.order-book .amount {
    color: #666;
}
.order-book .current-price {
    text-align: center;
    padding: 15px 0;
    border-top: 2px solid #eee;
    border-bottom: 2px solid #eee;
    margin: 10px 0;
}
.order-book .current-price .price {
    font-size: 28px;
    font-weight: 800;
    color: #10b981;
}
.order-book .current-price .label {
    font-size: 12px;
    color: #999;
}
</style>

<div class="order-book">
