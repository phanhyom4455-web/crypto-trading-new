<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>币币兑换 - 数字货币交易平台</title>
    <link href="https://cdn.bootcdn.net/ajax/libs/twitter-bootstrap/5.3.0/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.bootcdn.net/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <style>
        body { font-family: 'Segoe UI', sans-serif; padding-top: 70px; background: #f0f2f5; padding-bottom: 80px; }
        .navbar { background: linear-gradient(135deg, #667eea, #764ba2); padding: 12px 0; position: fixed; top: 0; left: 0; right: 0; z-index: 1000; }
        .navbar-brand { color: #fff !important; font-weight: 800; font-size: 24px; }
        .navbar-brand i { margin-right: 10px; }
        .nav-link { color: rgba(255,255,255,0.85) !important; font-weight: 500; padding: 8px 18px !important; border-radius: 8px; }
        .nav-link:hover { color: #fff !important; background: rgba(255,255,255,0.15); }
        .nav-link i { margin-right: 6px; }
        .user-avatar { width: 36px; height: 36px; border-radius: 50%; background: rgba(255,255,255,0.2); display: flex; align-items: center; justify-content: center; color: #fff; font-weight: 600; border: 2px solid rgba(255,255,255,0.3); }
        .dropdown-menu { border-radius: 12px; box-shadow: 0 10px 40px rgba(0,0,0,0.15); border: none; padding: 8px; }
        .dropdown-item { border-radius: 8px; padding: 10px 20px; }
        .dropdown-item:hover { background: #f3f4f6; }
        .dropdown-item i { width: 20px; margin-right: 10px; color: #667eea; }
    </style>
</head>
<body>

    <!-- ===== 导航栏 ===== -->
    <nav class="navbar navbar-expand-lg">
        <div class="container">
            <a class="navbar-brand" href="/"><i class="fas fa-coins"></i>CoinTrade</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav mx-auto">
                    <li class="nav-item"><a class="nav-link" href="/">首页</a></li>
                    <li class="nav-item"><a class="nav-link" href="/market">行情</a></li>
                    <li class="nav-item"><a class="nav-link" href="/trade">交易</a></li>
                    <li class="nav-item"><a class="nav-link" href="/deposit">充值</a></li>
                    <li class="nav-item"><a class="nav-link" href="/withdraw">提现</a></li>
                    <li class="nav-item"><a class="nav-link active" href="/exchange">兑换</a></li>
                </ul>
                <div class="d-flex align-items-center gap-2">
                    <% if (user) { %>
                        <div class="dropdown">
                            <button class="btn dropdown-toggle d-flex align-items-center gap-2" style="color: #fff; border: none; padding: 4px 12px;" data-bs-toggle="dropdown">
                                <div class="user-avatar"><%= user.username.charAt(0).toUpperCase() %></div>
                                <span><%= user.username %></span>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><a class="dropdown-item" href="/profile"><i class="fas fa-user"></i>个人中心</a></li>
                                <li><a class="dropdown-item" href="/assets"><i class="fas fa-wallet"></i>资产明细</a></li>
                                <li><a class="dropdown-item" href="/trade-history"><i class="fas fa-history"></i>交易记录</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item text-danger" href="/api/logout"><i class="fas fa-sign-out-alt"></i>退出登录</a></li>
                            </ul>
                        </div>
                    <% } %>
                </div>
            </div>
        </div>
    </nav>

<style>
.exchange-page {
    max-width: 600px;
    margin: 30px auto;
    padding: 0 15px;
}
.exchange-card {
    background: #fff;
    border-radius: 16px;
    padding: 30px;
    box-shadow: 0 4px 20px rgba(0,0,0,0.08);
}
.exchange-card h3 {
    font-weight: 800;
    margin-bottom: 5px;
}
.exchange-card .subtitle {
    color: #999;
    font-size: 13px;
    margin-bottom: 25px;
}
.balance-info {
    background: #f8f9fa;
    border-radius: 12px;
    padding: 15px;
    margin-bottom: 20px;
}
.balance-info .label {
    font-size: 12px;
    color: #999;
}
.balance-info .value {
    font-size: 20px;
    font-weight: 700;
    color: #667eea;
}
.exchange-form-group {
    margin-bottom: 20px;
}
.exchange-form-group label {
    font-weight: 600;
    font-size: 14px;
    display: block;
    margin-bottom: 8px;
}
.exchange-form-group select,
.exchange-form-group input {
    width: 100%;
    padding: 14px;
    border: 2px solid #e8ecf1;
    border-radius: 12px;
    font-size: 15px;
    transition: 0.3s;
}
.exchange-form-group select:focus,
.exchange-form-group input:focus {
    outline: none;
    border-color: #667eea;
}
.swap-icon {
    text-align: center;
    margin: 10px 0;
    font-size: 24px;
    color: #667eea;
    cursor: pointer;
}
.rate-info {
    background: linear-gradient(135deg, #667eea, #764ba2);
    color: #fff;
    padding: 15px;
    border-radius: 12px;
    text-align: center;
    margin: 20px 0;
}
.rate-info .rate {
    font-size: 22px;
    font-weight: 800;
}
.rate-info .info {
    font-size: 12px;
    opacity: 0.8;
    margin-top: 5px;
}
.btn-exchange {
    width: 100%;
    background: linear-gradient(135deg, #667eea, #764ba2);
    color: #fff;
    border: none;
    border-radius: 12px;
    padding: 16px;
    font-size: 16px;
    font-weight: 700;
    cursor: pointer;
    transition: 0.3s;
}
.btn-exchange:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 25px rgba(102,126,234,0.4);
}
.btn-exchange:disabled {
    opacity: 0.5;
    cursor: not-allowed;
}
.result-box {
    display: none;
    margin-top: 20px;
    padding: 15px;
    border-radius: 12px;
    text-align: center;
    font-weight: 600;
}
.result-box.success {
    display: block;
    background: #d1fae5;
    color: #059669;
}
.result-box.error {
    display: block;
    background: #fee2e2;
    color: #dc2626;
}
</style>

<div class="exchange-page">
    <div class="exchange-card">
        <h3>💱 币币兑换</h3>
        <div class="subtitle">实时汇率 · 手续费 0.1%</div>

        <!-- 可用余额 -->
        <div class="balance-info">
            <div class="label">可用余额</div>
            <div class="value" id="availableBalance">加载中...</div>
        </div>

        <!-- 卖出 -->
        <div class="exchange-form-group">
            <label>卖出</label>
            <select id="sellCurrency" onchange="onCurrencyChange()"></select>
        </div>

        <!-- 交换按钮 -->
        <div class="swap-icon" onclick="swapCurrencies()">
            <i class="fas fa-arrow-down"></i>
        </div>

        <!-- 买入 -->
        <div class="exchange-form-group">
            <label>买入</label>
            <select id="buyCurrency" onchange="onCurrencyChange()"></select>
        </div>

        <!-- 实时汇率 -->
        <div class="rate-info">
            <div class="rate" id="exchangeRate">1 USDT = 1 USDT</div>
            <div class="info">实时汇率 · 手续费 0.1%</div>
        </div>

        <!-- 兑换数量 -->
        <div class="exchange-form-group">
            <label>兑换数量</label>
            <input type="number" id="exchangeAmount" placeholder="请输入数量" min="0" step="any" oninput="calculateExchange()">
        </div>

        <!-- 兑换结果预览 -->
        <div class="result-box" id="resultBox"></div>

        <!-- 确认按钮 -->
        <button class="btn-exchange" id="exchangeBtn" onclick="confirmExchange()">
            <i class="fas fa-exchange-alt me-2"></i>确认兑换
        </button>
    </div>
</div>

<script>
// ============================================
// 全局变量
// ============================================
let currencies = [];       // 币种列表
let currentPrices = {};    // 实时价格
let userAssets = {};       // 用户资产

// ============================================
// 加载币种列表
// ============================================
async function loadCurrencies() {
    try {
        const res = await fetch('/api/currencies');
        const data = await res.json();
        if (data.success) {
            currencies = data.currencies;
            renderCurrencyOptions();
        }
    } catch (e) {
        console.error('加载币种失败', e);
    }
}

function renderCurrencyOptions() {
    const sellSelect = document.getElementById('sellCurrency');
    const buySelect = document.getElementById('buyCurrency');

    sellSelect.innerHTML = '';
    buySelect.innerHTML = '';

    currencies.forEach(c => {
        sellSelect.innerHTML += `<option value="${c.symbol}">${c.symbol} (${c.name})</option>`;
        buySelect.innerHTML += `<option value="${c.symbol}">${c.symbol} (${c.name})</option>`;
    });

    // 默认：卖出 USDT，买入 BTC
    sellSelect.value = 'USDT';
    buySelect.value = 'BTC';

    onCurrencyChange();
}

// ============================================
// 加载用户资产
// ============================================
async function loadUserAssets() {
    try {
        const res = await fetch('/api/assets');
        const data = await res.json();
        if (data.success) {
            userAssets = {};
            data.assets.forEach(a => {
                userAssets[a.currency] = parseFloat(a.balance) || 0;
            });
            updateAvailableBalance();
        }
    } catch (e) {
        console.error('加载资产失败', e);
    }
}

function updateAvailableBalance() {
    const sellCur = document.getElementById('sellCurrency').value;
    const balance = userAssets[sellCur] || 0;
    document.getElementById('availableBalance').textContent = balance.toFixed(8) + ' ' + sellCur;
}

// ============================================
// 加载价格
// ============================================
async function loadPrices() {
    try {
        const res = await fetch('/api/coin-prices');
        const data = await res.json();
        if (data.success) {
            currentPrices = data.prices;
        }
    } catch (e) {
        console.error('加载价格失败', e);
    }
}

// ============================================
// 币种变化
// ============================================
function onCurrencyChange() {
    updateAvailableBalance();
    updateExchangeRate();
}

// ============================================
// 交换买卖币种
// ============================================
function swapCurrencies() {
    const sellSelect = document.getElementById('sellCurrency');
    const buySelect = document.getElementById('buyCurrency');
    const tmp = sellSelect.value;
    sellSelect.value = buySelect.value;
    buySelect.value = tmp;
    onCurrencyChange();
}

// ============================================
// 更新汇率显示
// ============================================
function updateExchangeRate() {
    const sell = document.getElementById('sellCurrency').value;
    const buy = document.getElementById('buyCurrency').value;

    const sellPrice = currentPrices[sell] || 0;
    const buyPrice = currentPrices[buy] || 0;
    const rate = buyPrice > 0 ? (sellPrice / buyPrice) : 0;

    document.getElementById('exchangeRate').textContent =
        `1 ${sell} = ${rate.toFixed(8)} ${buy}`;

    calculateExchange();
}

// ============================================
// 计算兑换结果（预览）
// ============================================
function calculateExchange() {
    const sell = document.getElementById('sellCurrency').value;
    const buy = document.getElementById('buyCurrency').value;
    const amount = parseFloat(document.getElementById('exchangeAmount').value) || 0;

    const resultBox = document.getElementById('resultBox');

    if (amount <= 0) {
        resultBox.className = 'result-box';
        resultBox.style.display = 'none';
        return;
    }

    if (sell === buy) {
        resultBox.className = 'result-box error';
        resultBox.innerHTML = '❌ 卖出和买入不能相同';
        return;
    }

    const sellPrice = currentPrices[sell] || 0;
    const buyPrice = currentPrices[buy] || 0;
    const rate = buyPrice > 0 ? (sellPrice / buyPrice) : 0;
    const toAmount = amount * rate;
    const fee = toAmount * 0.001;
    const finalAmount = toAmount - fee;

    // 检查余额
    const balance = userAssets[sell] || 0;
    if (balance < amount) {
        resultBox.className = 'result-box error';
        resultBox.innerHTML = '❌ 余额不足（可用：' + balance.toFixed(8) + ' ' + sell + '）';
        return;
    }

    resultBox.className = 'result-box success';
    resultBox.innerHTML =
        '✅ 可兑换：<strong>' + finalAmount.toFixed(8) + ' ' + buy + '</strong>' +
        '<br><small>汇率: 1 ' + sell + ' = ' + rate.toFixed(8) + ' ' + buy +
        ' · 手续费: ' + fee.toFixed(8) + ' ' + buy + '</small>';
}

// ============================================
// 确认兑换
// ============================================
async function confirmExchange() {
    const sell = document.getElementById('sellCurrency').value;
    const buy = document.getElementById('buyCurrency').value;
    const amount = parseFloat(document.getElementById('exchangeAmount').value) || 0;

    if (amount <= 0) {
        alert('请输入有效的兑换数量');
        return;
    }

    if (sell === buy) {
        alert('卖出和买入不能相同');
        return;
    }

    const btn = document.getElementById('exchangeBtn');
    const resultBox = document.getElementById('resultBox');

    btn.disabled = true;
    btn.innerHTML = '⏳ 兑换中...';

    try {
        const res = await fetch('/api/exchange', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ from: sell, to: buy, amount: amount })
        });
        const data = await res.json();

        if (data.success) {
            resultBox.className = 'result-box success';
            resultBox.innerHTML =
                '✅ 兑换成功！<br>' +
                amount + ' ' + sell + ' → <strong>' + data.toAmount.toFixed(8) + ' ' + buy + '</strong>';

            document.getElementById('exchangeAmount').value = '';

            // ✅ 自动刷新资产
            await loadUserAssets();

            setTimeout(() => {
                resultBox.style.display = 'none';
            }, 5000);
        } else {
            resultBox.className = 'result-box error';
            resultBox.innerHTML = '❌ ' + (data.message || '兑换失败');
        }
    } catch (e) {
        resultBox.className = 'result-box error';
        resultBox.innerHTML = '❌ 网络错误，请重试';
        console.error(e);
    } finally {
        btn.disabled = false;
        btn.innerHTML = '<i class="fas fa-exchange-alt me-2"></i>确认兑换';
    }
}

// ============================================
// 页面加载
// ============================================
document.addEventListener('DOMContentLoaded', async () => {
    await loadPrices();
    await loadCurrencies();
    await loadUserAssets();
});
</script>
    <script src="https://cdn.bootcdn.net/ajax/libs/twitter-bootstrap/5.3.0/js/bootstrap.bundle.min.js"></script>
   <%- include('../includes/bottom-nav') %>

</body>
</html>