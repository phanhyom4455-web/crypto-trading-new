                            <td>$61,800.00</td>
                            <td>12,450 BTC</td>
                            <td>
                                <a href="/trade?pair=BTC/USDT&type=buy" class="trade-btn trade-btn-buy me-1" style="text-decoration:none; display:inline-block;">买入</a>
                                <a href="/trade?pair=BTC/USDT&type=sell" class="trade-btn trade-btn-sell" style="text-decoration:none; display:inline-block;">卖出</a>
                            </td>
                        </tr>
                        <tr>
                            <td><strong>ETH/USDT</strong></td>
                            <td>$2,450.75</td>
                            <td><span class="badge-down">-1.20%</span></td>
                            <td>$2,520.00</td>
                            <td>$2,420.00</td>
                            <td>85,600 ETH</td>
                            <td>
                                <a href="/trade?pair=ETH/USDT&type=buy" class="trade-btn trade-btn-buy me-1" style="text-decoration:none; display:inline-block;">买入</a>
                                <a href="/trade?pair=ETH/USDT&type=sell" class="trade-btn trade-btn-sell" style="text-decoration:none; display:inline-block;">卖出</a>
                            </td>
                        </tr>
                        <tr>
                            <td><strong>ADA/USDT</strong></td>
                            <td>$0.4520</td>
                            <td><span class="badge-up">+5.60%</span></td>
                            <td>$0.4680</td>
                            <td>$0.4300</td>
                            <td>324,500 ADA</td>
                            <td>
                                <a href="/trade?pair=ADA/USDT&type=buy" class="trade-btn trade-btn-buy me-1" style="text-decoration:none; display:inline-block;">买入</a>
                                <a href="/trade?pair=ADA/USDT&type=sell" class="trade-btn trade-btn-sell" style="text-decoration:none; display:inline-block;">卖出</a>
                            </td>
                        </tr>
                        <tr>
                            <td><strong>DOT/USDT</strong></td>
                            <td>$6.2500</td>
                            <td><span class="badge-up">+3.80%</span></td>
                            <td>$6.4500</td>
                            <td>$6.1000</td>
                            <td>12,400 DOT</td>
                            <td>
                                <a href="/trade?pair=DOT/USDT&type=buy" class="trade-btn trade-btn-buy me-1" style="text-decoration:none; display:inline-block;">买入</a>
                                <a href="/trade?pair=DOT/USDT&type=sell" class="trade-btn trade-btn-sell" style="text-decoration:none; display:inline-block;">卖出</a>
                            </td>
                        </tr>
                        <tr>
                            <td><strong>SOL/USDT</strong></td>
                            <td>$25.80</td>
                            <td><span class="badge-up">+4.20%</span></td>
                            <td>$26.50</td>
                            <td>$24.80</td>
                            <td>56,200 SOL</td>
                            <td>
                                <a href="/trade?pair=SOL/USDT&type=buy" class="trade-btn trade-btn-buy me-1" style="text-decoration:none; display:inline-block;">买入</a>
                                <a href="/trade?pair=SOL/USDT&type=sell" class="trade-btn trade-btn-sell" style="text-decoration:none; display:inline-block;">卖出</a>
                            </td>
                        </tr>
                        <tr>
                            <td><strong>AVAX/USDT</strong></td>
                            <td>$14.20</td>
                            <td><span class="badge-up">+6.80%</span></td>
                            <td>$14.80</td>
                            <td>$13.50</td>
                            <td>28,900 AVAX</td>
                            <td>
                                <a href="/trade?pair=AVAX/USDT&type=buy" class="trade-btn trade-btn-buy me-1" style="text-decoration:none; display:inline-block;">买入</a>
                                <a href="/trade?pair=AVAX/USDT&type=sell" class="trade-btn trade-btn-sell" style="text-decoration:none; display:inline-block;">卖出</a>
                            </td>
                        </tr>
                        <tr>
                            <td><strong>MATIC/USDT</strong></td>
                            <td>$0.72</td>
                            <td><span class="badge-down">-2.10%</span></td>
                            <td>$0.75</td>
                            <td>$0.70</td>
                            <td>156,000 MATIC</td>
                            <td>
                                <a href="/trade?pair=MATIC/USDT&type=buy" class="trade-btn trade-btn-buy me-1" style="text-decoration:none; display:inline-block;">买入</a>
                                <a href="/trade?pair=MATIC/USDT&type=sell" class="trade-btn trade-btn-sell" style="text-decoration:none; display:inline-block;">卖出</a>
                            </td>
                        </tr>
                        <tr>
                            <td><strong>LINK/USDT</strong></td>
                            <td>$12.80</td>
                            <td><span class="badge-up">+3.50%</span></td>
                            <td>$13.20</td>
                            <td>$12.40</td>
                            <td>8,900 LINK</td>
                            <td>
                                <a href="/trade?pair=LINK/USDT&type=buy" class="trade-btn trade-btn-buy me-1" style="text-decoration:none; display:inline-block;">买入</a>
                                <a href="/trade?pair=LINK/USDT&type=sell" class="trade-btn trade-btn-sell" style="text-decoration:none; display:inline-block;">卖出</a>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <script src="https://cdn.bootcdn.net/ajax/libs/twitter-bootstrap/5.3.0/js/bootstrap.bundle.min.js"></script>
    <script>
        function changePeriod(period) {
            document.querySelectorAll('.card-custom .btn-outline-secondary').forEach(function(b) { b.classList.remove('active'); });
            if (event && event.target) {
                event.target.classList.add('active');
            }
            var intervalMap = { '1H': '60', '1D': 'D', '1W': 'W', '1M': 'M' };
            var interval = intervalMap[period] || '60';
            if (window.updateTVInterval) {
                window.updateTVInterval(interval);
            }
        }
    </script>

    <%- include('../includes/bottom-nav') %>

</body>
</html>