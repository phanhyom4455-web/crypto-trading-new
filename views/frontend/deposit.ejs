<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>充值 - 数字货币交易平台</title>
    <link href="https://cdn.bootcdn.net/ajax/libs/twitter-bootstrap/5.3.0/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.bootcdn.net/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <style>
        body { font-family: 'Segoe UI', sans-serif; padding-top: 70px; background: #f8f9fa; }
        .navbar { background: linear-gradient(135deg, #667eea, #764ba2); padding: 15px 0; box-shadow: 0 4px 20px rgba(102,126,234,0.3); position: fixed; top: 0; left: 0; right: 0; z-index: 1000; }
        .navbar-brand { color: #fff !important; font-weight: 800; font-size: 24px; }
        .navbar-brand i { margin-right: 10px; }
        .nav-link { color: rgba(255,255,255,0.85) !important; font-weight: 500; padding: 8px 18px !important; border-radius: 8px; transition: all 0.3s; }
        .nav-link:hover, .nav-link.active { color: #fff !important; background: rgba(255,255,255,0.15); }
        .nav-link i { margin-right: 6px; }
        .btn-login { color: #fff !important; border: 2px solid rgba(255,255,255,0.4); border-radius: 50px; padding: 8px 24px; background: transparent; }
        .btn-login:hover { background: rgba(255,255,255,0.15); }
        .btn-register { background: #fff; color: #667eea !important; border: none; border-radius: 50px; padding: 8px 24px; font-weight: 600; }
        .btn-register:hover { transform: translateY(-2px); box-shadow: 0 8px 25px rgba(255,255,255,0.3); }
        .user-avatar { width: 36px; height: 36px; border-radius: 50%; background: rgba(255,255,255,0.2); display: flex; align-items: center; justify-content: center; color: #fff; font-weight: 600; border: 2px solid rgba(255,255,255,0.3); }
        .dropdown-menu { border-radius: 12px; box-shadow: 0 10px 40px rgba(0,0,0,0.15); border: none; padding: 8px; }
        .dropdown-item { border-radius: 8px; padding: 10px 20px; }
        .dropdown-item:hover { background: #f3f4f6; }
        .dropdown-item i { width: 20px; margin-right: 10px; color: #667eea; }
        .footer { background: #1a202c; color: rgba(255,255,255,0.7); padding: 40px 0; margin-top: 50px; }
        .footer a { color: rgba(255,255,255,0.6); text-decoration: none; display: block; padding: 4px 0; }
        .footer a:hover { color: #fff; }
        .footer h5 { color: #fff; font-weight: 700; }
        .deposit-card { background: #fff; border-radius: 16px; padding: 30px; box-shadow: 0 4px 20px rgba(0,0,0,0.06); height: 100%; }
        .section-title { text-align: center; margin-bottom: 40px; }
        .section-title h2 { font-size: 36px; font-weight: 800; }
        .section-title p { color: #6b7280; }
        .form-control { border-radius: 10px; padding: 12px 16px; border: 2px solid #e5e7eb; }
        .form-control:focus { border-color: #10b981; box-shadow: 0 0 0 3px rgba(16,185,129,0.2); }
        .btn-deposit { background: linear-gradient(135deg, #10b981, #059669); border: none; border-radius: 10px; padding: 12px; font-weight: 600; color: #fff; width: 100%; }
        .btn-deposit:hover { transform: translateY(-2px); box-shadow: 0 8px 25px rgba(16,185,129,0.4); }
        .btn-deposit:disabled { opacity: 0.6; cursor: not-allowed; }
        .address-box { background: #f3f4f6; padding: 15px; border-radius: 10px; word-break: break-all; font-family: monospace; font-size: 14px; }
        .badge-status { padding: 6px 14px; border-radius: 50px; font-size: 12px; font-weight: 600; }
        .badge-completed { background: #d1fae5; color: #065f46; }
        .badge-pending { background: #fef3c7; color: #92400e; }
        .badge-failed { background: #fee2e2; color: #991b1b; }
        .spinner { display: none; }
        .btn-deposit.loading .spinner { display: inline-block; }
        .btn-deposit.loading .btn-text { display: none; }
        .alert { border-radius: 10px; padding: 12px 16px; }
        .alert-success { background: #d1fae5; color: #065f46; border: none; }
        .alert-danger { background: #fee2e2; color: #991b1b; border: none; }
        .address-generated { background: #f0fdf4; border: 2px solid #10b981; border-radius: 10px; padding: 15px; text-align: center; }
        .address-generated code { font-size: 16px; color: #065f46; word-break: break-all; }
    </style>
</head>
<body>

    <!-- ===== 导航栏 ===== -->
    <nav class="navbar navbar-expand-lg">
        <div class="container">
            <a class="navbar-brand" href="/"><i class="fas fa-coins"></i>CoinTrade</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon" style="filter: invert(1);"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav mx-auto">
                    <li class="nav-item"><a class="nav-link" href="/">首页</a></li>
                    <li class="nav-item"><a class="nav-link" href="/market">行情</a></li>
                    <li class="nav-item"><a class="nav-link active" href="/deposit">充值</a></li>
                    <li class="nav-item"><a class="nav-link" href="/withdraw">提现</a></li>
                    <li class="nav-item"><a class="nav-link" href="/help">帮助</a></li>
                    
                </ul>
                <div class="d-flex align-items-center gap-2">
                    <% if (user) { %>
                        <div class="dropdown">
                            <button class="btn dropdown-toggle d-flex align-items-center gap-2" style="color: #fff; border: none; padding: 4px 12px;" data-bs-toggle="dropdown">
                                <div class="user-avatar"><%= user.username.charAt(0).toUpperCase() %></div>
                                <span><%= user.username %></span>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><a class="dropdown-item" href="/profile"><i class="fas fa-user"></i>个人中心</a></li>
                                <li><a class="dropdown-item" href="/deposit"><i class="fas fa-arrow-down"></i>充值</a></li>
                                <li><a class="dropdown-item" href="/withdraw"><i class="fas fa-arrow-up"></i>提现</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item text-danger" href="/api/logout"><i class="fas fa-sign-out-alt"></i>退出登录</a></li>
                            </ul>
                        </div>
                    <% } else { %>
                        <a href="/login" class="btn btn-login"><i class="fas fa-sign-in-alt"></i>登录</a>
                        <a href="/register" class="btn btn-register"><i class="fas fa-user-plus"></i>注册</a>
                    <% } %>
                </div>
            </div>
        </div>
    </nav>

    <!-- ===== 主内容 ===== -->
    <div class="container py-5">
        <div class="section-title">
            <h2>充值</h2>
            <p>安全快捷的充值服务</p>
        </div>

        <!-- 消息提示 -->
        <div id="message" style="display: none;" class="alert mb-3"></div>

        <div class="row g-4">
            <div class="col-lg-6">
                <div class="deposit-card">
                    <h5 class="fw-bold mb-4"><i class="fas fa-arrow-down text-success me-2"></i>选择充值币种</h5>
                    
                    <!-- 充值表单 -->
                    <form id="depositForm" onsubmit="submitDeposit(event)">
                        <div class="mb-3">
                            <label class="fw-bold">币种</label>
                            <select class="form-control" id="depositMethod" required>
                                <option value="USDT">USDT (TRC20)</option>
                                <option value="BTC">BTC</option>
                                <option value="ETH">ETH</option>
                                <option value="USDC">USDC (ERC20)</option>
                                <option value="BUSD">BUSD</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="fw-bold">充值金额</label>
                            <input type="number" class="form-control" id="depositAmount" placeholder="请输入充值金额" min="1" step="0.01" required>
                        </div>
                        
                        <!-- 生成的地址 -->
                        <div id="addressContainer" style="display: none;" class="mb-3">
                            <label class="fw-bold">充值地址</label>
                            <div class="address-generated">
                                <code id="generatedAddress">0x8f2a4b3c9d1e5f6a7b8c9d0e1f2a3b4c5d6e7f8</code>
                                <button class="btn btn-sm btn-outline-success mt-2" onclick="copyAddress()">
                                    <i class="fas fa-copy"></i> 复制地址
                                </button>
                            </div>
                        </div>

                        <button type="submit" class="btn-deposit" id="depositBtn">
                            <span class="spinner"><i class="fas fa-spinner fa-spin"></i></span>
                            <span class="btn-text"><i class="fas fa-arrow-down me-2"></i>生成充值地址</span>
                        </button>
                    </form>

                    <div class="mt-3 p-3 bg-light rounded-3">
                        <i class="fas fa-info-circle text-success me-2"></i>
                        <small class="text-muted">充值到账通常需要 1-3 个区块确认，请耐心等待</small>
                    </div>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="deposit-card">
                    <h5 class="fw-bold mb-4"><i class="fas fa-history me-2 text-primary"></i>充值记录</h5>
                    <div class="table-responsive" id="depositRecords">
                        <table class="table table-hover">
                            <thead><tr><th>币种</th><th>金额</th><th>状态</th><th>时间</th></tr></thead>
                            <tbody id="depositList">
                                <tr>
                                    <td colspan="4" class="text-center text-muted py-3">加载中...</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>


    <script src="https://cdn.bootcdn.net/ajax/libs/twitter-bootstrap/5.3.0/js/bootstrap.bundle.min.js"></script>
    <script>
        let generatedAddress = '';

        function showMessage(message, type) {
            const msgDiv = document.getElementById('message');
            msgDiv.style.display = 'block';
            msgDiv.textContent = message;
            msgDiv.className = 'alert mb-3 ' + (type === 'success' ? 'alert-success' : 'alert-danger');
            setTimeout(() => { msgDiv.style.display = 'none'; }, 5000);
        }

        async function submitDeposit(event) {
            event.preventDefault();

            // 检查是否登录
            <% if (!user) { %>
                if (confirm('请先登录才能充值！\n是否前往登录？')) {
                    window.location.href = '/login';
                }
                return;
            <% } %>

            const method = document.getElementById('depositMethod').value;
            const amount = document.getElementById('depositAmount').value;
            const btn = document.getElementById('depositBtn');

            if (!amount || amount <= 0) {
                showMessage('请输入有效的充值金额', 'error');
                return;
            }

            btn.classList.add('loading');
            btn.disabled = true;
            document.getElementById('message').style.display = 'none';

            try {
                const response = await fetch('/api/deposit', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ method, amount })
                });
                const data = await response.json();

                if (data.success) {
                    generatedAddress = data.address;
                    document.getElementById('generatedAddress').textContent = data.address;
                    document.getElementById('addressContainer').style.display = 'block';
                    showMessage('✅ ' + data.message, 'success');
                    loadDeposits();
                    document.getElementById('depositAmount').value = '';
                } else {
                    showMessage('❌ ' + data.message, 'error');
                }
            } catch (error) {
                showMessage('❌ 网络错误，请重试', 'error');
            } finally {
                btn.classList.remove('loading');
                btn.disabled = false;
            }
        }

        function copyAddress() {
            if (generatedAddress) {
                navigator.clipboard.writeText(generatedAddress).then(() => {
                    showMessage('✅ 地址已复制到剪贴板', 'success');
                }).catch(() => {
                    // 降级方案
                    const textarea = document.createElement('textarea');
                    textarea.value = generatedAddress;
                    document.body.appendChild(textarea);
                    textarea.select();
                    document.execCommand('copy');
                    document.body.removeChild(textarea);
                    showMessage('✅ 地址已复制到剪贴板', 'success');
                });
            }
        }

        async function loadDeposits() {
            try {
                const response = await fetch('/api/deposits');
                const data = await response.json();
                const tbody = document.getElementById('depositList');
                
                if (data.success && data.deposits && data.deposits.length > 0) {
                    tbody.innerHTML = '';
                    data.deposits.forEach(d => {
                        const statusMap = {
                            'pending': '<span class="badge-status badge-pending">待处理</span>',
                            'completed': '<span class="badge-status badge-completed">已完成</span>',
                            'failed': '<span class="badge-status badge-failed">失败</span>'
                        };
                        tbody.innerHTML += `
                            <tr>
                                <td>${d.method || 'USDT'}</td>
                                <td>${d.amount}</td>
                                <td>${statusMap[d.status] || statusMap['pending']}</td>
                                <td>${new Date(d.created_at).toLocaleString()}</td>
                            </tr>
                        `;
                    });
                } else {
                    tbody.innerHTML = `<tr><td colspan="4" class="text-center text-muted py-3">暂无充值记录</td></tr>`;
                }
            } catch (error) {
                console.log('加载充值记录失败');
            }
        }

        // 页面加载时加载记录
        document.addEventListener('DOMContentLoaded', loadDeposits);
    </script>
    <%- include('../includes/bottom-nav') %>

</body>
</html>