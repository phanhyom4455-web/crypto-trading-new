<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>注册 - 数字货币交易平台</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .register-container {
            background: white;
            border-radius: 20px;
            padding: 40px;
            width: 450px;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
        }
        .register-header { text-align: center; margin-bottom: 30px; }
        .register-header .logo { font-size: 48px; margin-bottom: 10px; }
        .register-header h1 { font-size: 28px; color: #333; margin-bottom: 8px; }
        .register-header p { color: #888; font-size: 14px; }
        .register-tabs {
            display: flex;
            margin-bottom: 20px;
            background: #f0f2f5;
            border-radius: 10px;
            padding: 4px;
        }
        .tab-btn {
            flex: 1;
            padding: 10px;
            border: none;
            background: transparent;
            border-radius: 8px;
            font-size: 14px;
            font-weight: 600;
            color: #666;
            cursor: pointer;
            transition: all 0.3s;
        }
        .tab-btn.active {
            background: white;
            color: #667eea;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
        }
        .form-group { margin-bottom: 20px; }
        .form-group label { display: block; margin-bottom: 8px; font-size: 14px; color: #555; font-weight: 500; }
        .input-wrapper { position: relative; }
        .input-icon { position: absolute; left: 12px; top: 50%; transform: translateY(-50%); color: #aaa; font-size: 18px; }
        .form-group input {
            width: 100%; padding: 12px 12px 12px 42px; border: 2px solid #e8ecf1;
            border-radius: 10px; font-size: 14px; transition: border-color 0.3s, box-shadow 0.3s;
        }
        .form-group input:focus { outline: none; border-color: #667eea; box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1); }
        .register-btn {
            width: 100%; padding: 14px; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white; border: none; border-radius: 10px; font-size: 16px;
            font-weight: 600; cursor: pointer; transition: transform 0.2s, box-shadow 0.2s; margin-bottom: 20px;
        }
        .register-btn:hover { transform: translateY(-2px); box-shadow: 0 8px 25px rgba(102, 126, 234, 0.4); }
        .register-btn:disabled { opacity: 0.6; transform: none; }
        .login-link { text-align: center; font-size: 14px; color: #666; }
        .login-link a { color: #667eea; text-decoration: none; font-weight: 600; }
        .message { padding: 12px; border-radius: 8px; margin-bottom: 20px; font-size: 14px; display: none; }
        .message.error { background: #fee2e2; color: #dc2626; border: 1px solid #fecaca; }
        .message.success { background: #d1fae5; color: #059669; border: 1px solid #a7f3d0; }
        .message.info { background: #dbeafe; color: #2563eb; border: 1px solid #bfdbfe; }
        .verify-section { display: none; text-align: center; }
        .verify-icon { font-size: 64px; margin-bottom: 20px; }
        .verify-input {
            width: 200px; padding: 12px; border: 2px solid #e8ecf1; border-radius: 10px;
            font-size: 24px; text-align: center; letter-spacing: 8px; margin: 20px auto; display: block;
        }
        .verify-input:focus { outline: none; border-color: #667eea; }
        .verify-btn {
            width: 100%; padding: 14px; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white; border: none; border-radius: 10px; font-size: 16px; font-weight: 600;
            cursor: pointer; transition: all 0.3s;
        }
        .verify-btn:hover { transform: translateY(-2px); box-shadow: 0 8px 25px rgba(102, 126, 234, 0.4); }
        .back-btn {
            background: #f0f2f5; color: #666; border: none; border-radius: 10px; padding: 12px 24px;
            font-size: 14px; cursor: pointer; margin-top: 15px; transition: all 0.3s;
        }
        .back-btn:hover { background: #e8ecf1; }
        .resend-btn { color: #667eea; background: none; border: none; font-size: 13px; cursor: pointer; margin-top: 10px; }
        .resend-btn:disabled { color: #999; cursor: not-allowed; }
        .verify-tip { color: #888; font-size: 13px; margin-bottom: 20px; }
    </style>
</head>
<body>
    <div class="register-container">
        <!-- 注册表单 -->
        <div id="registerForm">
            <div class="register-header">
                <div class="logo">💰</div>
                <h1>创建账号</h1>
                <p>选择邮箱或手机号注册</p>
            </div>
            
            <div class="register-tabs">
                <button class="tab-btn active" id="emailTab" onclick="switchTab('email')">📧 邮箱注册</button>
                <button class="tab-btn" id="phoneTab" onclick="switchTab('phone')">📱 手机注册</button>
            </div>
            
            <div class="message" id="message"></div>
            
            <div class="form-group">
                <label for="username">用户名</label>
                <div class="input-wrapper">
                    <span class="input-icon">👤</span>
                    <input type="text" id="username" placeholder="请输入用户名" autocomplete="username">
                </div>
            </div>
            
            <!-- 邮箱输入框 -->
            <div class="form-group" id="emailGroup">
                <label for="email">邮箱地址</label>
                <div class="input-wrapper">
                    <span class="input-icon">📧</span>
                    <input type="email" id="email" placeholder="请输入邮箱地址" autocomplete="email">
                </div>
            </div>
            
            <!-- 手机号输入框 -->
            <div class="form-group" id="phoneGroup" style="display: none;">
                <label for="phone">手机号码</label>
                <div class="input-wrapper">
                    <span class="input-icon">📱</span>
                    <input type="tel" id="phone" placeholder="请输入11位手机号码" autocomplete="tel">
                </div>
            </div>
            
            <div class="form-group">
                <label for="password">密码</label>
                <div class="input-wrapper">
                    <span class="input-icon">🔒</span>
                    <input type="password" id="password" placeholder="请输入密码（至少6位）" autocomplete="new-password">
                </div>
            </div>
            
            <div class="form-group">
                <label for="confirmPassword">确认密码</label>
                <div class="input-wrapper">
                    <span class="input-icon">✓</span>
                    <input type="password" id="confirmPassword" placeholder="请再次输入密码" autocomplete="new-password">
                </div>
            </div>
            
            <button type="button" class="register-btn" onclick="submitRegister()">下一步</button>
            
            <div class="login-link">
                已有账号？<a href="/login">立即登录</a>
            </div>
        </div>
        
        <!-- 验证码输入页面 -->
        <div id="verifyForm" class="verify-section">
            <div class="register-header">
                <div class="verify-icon">🔐</div>
                <h1>输入验证码</h1>
                <p class="verify-tip" id="verifyTip">验证码已发送到您的邮箱</p>
            </div>
            
            <div class="message" id="verifyMessage"></div>
            
            <input type="text" class="verify-input" id="verifyCode" placeholder="______" maxlength="6" inputmode="numeric">
            
            <button type="button" class="verify-btn" onclick="verifyCode()">确认验证</button>
            
            <button type="button" class="resend-btn" id="resendBtn" onclick="resendCode()">重新发送验证码</button>
            
            <br>
            
            <button type="button" class="back-btn" onclick="backToRegister()">← 返回修改</button>
        </div>
    </div>
    
    <script>
        let currentTab = 'email';
        let tempUserData = null;
        
        function switchTab(tab) {
            currentTab = tab;
            if (tab === 'email') {
                document.getElementById('emailTab').classList.add('active');
                document.getElementById('phoneTab').classList.remove('active');
                document.getElementById('emailGroup').style.display = 'block';
                document.getElementById('phoneGroup').style.display = 'none';
            } else {
                document.getElementById('phoneTab').classList.add('active');
                document.getElementById('emailTab').classList.remove('active');
                document.getElementById('emailGroup').style.display = 'none';
                document.getElementById('phoneGroup').style.display = 'block';
            }
        }
        
        function showMessage(type, text) {
            const message = document.getElementById('message');
            message.className = 'message ' + type;
            message.textContent = text;
            message.style.display = 'block';
            setTimeout(() => { message.style.display = 'none'; }, 5000);
        }
        
        function showVerifyMessage(type, text) {
            const message = document.getElementById('verifyMessage');
            message.className = 'message ' + type;
            message.textContent = text;
            message.style.display = 'block';
            setTimeout(() => { message.style.display = 'none'; }, 5000);
        }
        
        async function submitRegister() {
            const username = document.getElementById('username').value.trim();
            const email = document.getElementById('email').value.trim();
            const phone = document.getElementById('phone').value.trim();
            const password = document.getElementById('password').value;
            const confirmPassword = document.getElementById('confirmPassword').value;
            
            if (!username || username.length < 3) {
                showMessage('error', '用户名至少3个字符');
                return;
            }
            
            if (currentTab === 'email') {
                if (!email || !email.includes('@')) {
                    showMessage('error', '请输入有效的邮箱地址');
                    return;
                }
            } else {
                if (!phone || phone.length !== 11 || !/^\d+$/.test(phone)) {
                    showMessage('error', '请输入有效的11位手机号码');
                    return;
                }
            }
            
            if (!password || password.length < 6) {
                showMessage('error', '密码至少6个字符');
                return;
            }
            
            if (password !== confirmPassword) {
                showMessage('error', '两次输入的密码不一致');
                return;
            }
            
            const registerBtn = document.querySelector('.register-btn');
            const originalText = registerBtn.textContent;
            registerBtn.textContent = '提交中...';
            registerBtn.disabled = true;
            
            try {
                const registerData = {
                    username: username,
                    password: password
                };
                
                if (currentTab === 'email') {
                    registerData.email = email;
                    registerData.phone = '';
                } else {
                    registerData.phone = phone;
                    registerData.email = '';
                }
                
                const response = await fetch('/api/register', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(registerData)
                });
                
                const data = await response.json();
                
               if (data.success) {
    // 注册成功 → 跳转到注册成功页
    window.location.href = '/register-success';
} else {
    showMessage('error', data.message || '注册失败');
}
            } catch (error) {
                console.error('注册错误:', error);
                showMessage('error', '网络错误，请稍后重试');
            } finally {
                registerBtn.textContent = originalText;
                registerBtn.disabled = false;
            }
        }
        
        async function verifyCode() {
            const code = document.getElementById('verifyCode').value.trim();
            
            if (!code || code.length !== 6) {
                showVerifyMessage('error', '请输入6位验证码');
                return;
            }
            
            const verifyBtn = document.querySelector('.verify-btn');
            const originalText = verifyBtn.textContent;
            verifyBtn.textContent = '验证中...';
            verifyBtn.disabled = true;
            
            try {
                const response = await fetch('/api/verify-email', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        code: code,
                        email: tempUserData.email,
                        phone: tempUserData.phone
                    })
                });
                
                const data = await response.json();
                
                if (data.success) {
                    showVerifyMessage('success', '验证成功！');
                    setTimeout(() => {
                        window.location.href = '/login';
                    }, 1500);
                } else {
                    showVerifyMessage('error', data.message || '验证码错误');
                }
            } catch (error) {
                console.error('验证错误:', error);
                showVerifyMessage('error', '网络错误，请稍后重试');
            } finally {
                verifyBtn.textContent = originalText;
                verifyBtn.disabled = false;
            }
        }
        
        async function resendCode() {
            const resendBtn = document.getElementById('resendBtn');
            resendBtn.disabled = true;
            resendBtn.textContent = '发送中...';
            
            try {
                const data = tempUserData;
                const response = await fetch('/api/register', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        username: data.username,
                        email: data.email,
                        phone: data.phone,
                        password: data.password
                    })
                });
                
                const result = await response.json();
                
                if (result.success) {
                    showVerifyMessage('success', '验证码已重新发送！');
                    if (result.devCodes) {
                        if (currentTab === 'email') {
                            alert('邮箱验证码：' + result.devCodes.email);
                        } else {
                            alert('手机验证码：' + result.devCodes.phone);
                        }
                    }
                } else {
                    showVerifyMessage('error', '发送失败，请重试');
                }
            } catch (error) {
                showVerifyMessage('error', '网络错误，请稍后重试');
            } finally {
                resendBtn.disabled = false;
                resendBtn.textContent = '重新发送验证码';
            }
        }
        
        function backToRegister() {
            document.getElementById('verifyForm').style.display = 'none';
            document.getElementById('registerForm').style.display = 'block';
        }
    </script>
</body>
</html>