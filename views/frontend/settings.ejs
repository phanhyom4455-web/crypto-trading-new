<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>设置</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            background: #f0f2f5;
            min-height: 100vh;
            padding-bottom: 80px;
        }
        .header {
            background: white;
            padding: 16px 20px;
            display: flex;
            align-items: center;
            border-bottom: 1px solid #e8ecf1;
        }
        .header .back { text-decoration: none; font-size: 24px; margin-right: 16px; color: #1a1a2e; }
        .header h2 { font-size: 20px; color: #1a1a2e; }
        .container { max-width: 480px; margin: 0 auto; padding: 16px; }
        .card {
            background: white;
            border-radius: 20px;
            padding: 20px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.06);
            margin-bottom: 16px;
        }
        .card h3 { font-size: 16px; margin-bottom: 16px; color: #1a1a2e; }
        .form-group { margin-bottom: 14px; }
        .form-group label { display: block; font-weight: 600; margin-bottom: 4px; color: #333; font-size: 13px; }
        .form-group input {
            width: 100%;
            padding: 10px 14px;
            border: 2px solid #e8ecf1;
            border-radius: 10px;
            font-size: 14px;
            transition: 0.2s;
        }
        .form-group input:focus { border-color: #667eea; outline: none; }
        .btn {
            padding: 10px 24px;
            background: linear-gradient(135deg, #667eea, #764ba2);
            color: white;
            border: none;
            border-radius: 10px;
            font-size: 14px;
            font-weight: 600;
            cursor: pointer;
            transition: 0.2s;
        }
        .btn:hover { transform: translateY(-2px); box-shadow: 0 8px 25px rgba(102,126,234,0.4); }
        .btn-block { width: 100%; }
        .btn-success { background: linear-gradient(135deg, #27ae60, #2ecc71); }
        .btn-success:hover { box-shadow: 0 8px 25px rgba(39,174,96,0.4); }
        .message {
            padding: 10px;
            border-radius: 10px;
            margin-top: 10px;
            font-size: 14px;
            display: none;
        }
        .message.success { background: #e8f8f0; color: #27ae60; display: block; }
        .message.error { background: #fee; color: #e74c3c; display: block; }
        .bottom-nav {
            position: fixed;
            bottom: 0;
            left: 0;
            right: 0;
            background: white;
            display: flex;
            justify-content: space-around;
            padding: 8px 0;
            border-top: 1px solid #e8ecf1;
            max-width: 480px;
            margin: 0 auto;
        }
        .bottom-nav a {
            text-decoration: none;
            color: #888;
            font-size: 12px;
            text-align: center;
            padding: 4px 0;
            flex: 1;
        }
        .bottom-nav a .icon { font-size: 22px; display: block; }
        .bottom-nav a.active { color: #667eea; }
        .contact-btn {
            display: block;
            text-align: center;
            padding: 14px;
            background: #f8f9fa;
            border-radius: 12px;
            text-decoration: none;
            color: #1a1a2e;
            font-weight: 600;
            border: 2px solid #e8ecf1;
        }
        .contact-btn:hover { border-color: #667eea; }
    </style>
</head>
<body>
    <div class="header">
        <a href="/dashboard" class="back">‹</a>
        <h2>⚙️ 设置</h2>
    </div>

    <div class="container">
        <!-- 修改登录密码 -->
        <div class="card">
            <h3>🔐 修改登录密码</h3>
            <form id="passwordForm">
                <div class="form-group">
                    <label>当前密码</label>
                    <input type="password" id="old_password" required>
                </div>
                <div class="form-group">
                    <label>新密码</label>
                    <input type="password" id="new_password" required minlength="6">
                </div>
                <div class="form-group">
                    <label>确认新密码</label>
                    <input type="password" id="confirm_password" required>
                </div>
                <button type="button" class="btn btn-block" id="changePwdBtn">修改密码</button>
                <div id="pwdMessage" class="message"></div>
            </form>
        </div>

        <!-- 设置交易密码 -->
        <div class="card">
            <h3>🔑 设置交易密码</h3>
            <p style="font-size:13px;color:#888;margin-bottom:12px;">取款时需要使用交易密码验证</p>
            <form id="tradePwdForm">
                <div class="form-group">
                    <label>交易密码（至少6位）</label>
                    <input type="password" id="trade_password" required minlength="6">
                </div>
                <button type="button" class="btn btn-block btn-success" id="setTradePwdBtn">设置交易密码</button>
                <div id="tradePwdMessage" class="message"></div>
            </form>
        </div>

        <!-- 联系客服 -->
        <div class="card">
            <h3>📞 联系客服</h3>
            <a href="/contact" class="contact-btn">💬 点击联系客服</a>
        </div>
    </div>

    <div class="bottom-nav">
        <a href="/dashboard"><span class="icon">🏠</span>首页</a>
        <a href="/trade"><span class="icon">📈</span>交易</a>
        <a href="/deposit"><span class="icon">💰</span>充值</a>
        <a href="/withdraw"><span class="icon">🏦</span>取款</a>
        <a href="/settings" class="active"><span class="icon">⚙️</span>设置</a>
    </div>

    <script>
        // 修改登录密码
        document.getElementById('changePwdBtn').addEventListener('click', async function() {
            const old_password = document.getElementById('old_password').value;
            const new_password = document.getElementById('new_password').value;
            const confirm_password = document.getElementById('confirm_password').value;
            const msg = document.getElementById('pwdMessage');

            if (new_password !== confirm_password) {
                msg.className = 'message error';
                msg.textContent = '两次密码输入不一致';
                return;
            }
            if (new_password.length < 6) {
                msg.className = 'message error';
                msg.textContent = '密码至少6位';
                return;
            }

            const response = await fetch('/settings/password', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ old_password, new_password, confirm_password })
            });
            const data = await response.json();

            msg.className = 'message ' + (data.success ? 'success' : 'error');
            msg.textContent = data.message;
            if (data.success) {
                document.getElementById('old_password').value = '';
                document.getElementById('new_password').value = '';
                document.getElementById('confirm_password').value = '';
            }
        });

        // 设置交易密码
        document.getElementById('setTradePwdBtn').addEventListener('click', async function() {
            const trade_password = document.getElementById('trade_password').value;
            const msg = document.getElementById('tradePwdMessage');

            if (trade_password.length < 6) {
                msg.className = 'message error';
                msg.textContent = '交易密码至少6位';
                return;
            }

            const response = await fetch('/settings/trade-password', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ trade_password })
            });
            const data = await response.json();

            msg.className = 'message ' + (data.success ? 'success' : 'error');
            msg.textContent = data.message;
            if (data.success) {
                document.getElementById('trade_password').value = '';
            }
        });
    </script>
</body>
</html>