<% if (user) { %>
<style>
.kyc-entry {
    display: inline-block;
    margin-left: 10px;
    background: linear-gradient(135deg, #f59e0b, #d97706);
    color: #fff;
    padding: 8px 16px;
    border-radius: 50px;
    font-size: 13px;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.3s;
