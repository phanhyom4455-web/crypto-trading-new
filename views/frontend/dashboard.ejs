<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>控制台</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            background: #f0f2f5;
            min-height: 100vh;
            padding-bottom: 80px;
        }
        .header {
            background: white;
            padding: 16px 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid #e8ecf1;
            position: sticky;
            top: 0;
            z-index: 100;
        }
        .header h2 { font-size: 20px; color: #1a1a2e; }
        .header .user-info { display: flex; align-items: center; gap: 12px; }
        .header .avatar {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: linear-gradient(135deg, #667eea, #764ba2);
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            font-size: 18px;
        }
        .header .logout {
            color: #e74c3c;
            text-decoration: none;
            font-weight: 600;
            font-size: 14px;
        }
        .container { max-width: 480px; margin: 0 auto; padding: 16px 16px 100px; }
        .balance-card {
            background: linear-gradient(135deg, #1a1a2e, #16213e);
            border-radius: 20px;
            padding: 24px;
            color: white;
            margin-bottom: 20px;
        }
        .balance-card .label { font-size: 14px; opacity: 0.7; }
        .balance-card .amount { font-size: 36px; font-weight: 700; margin: 8px 0; }
        .balance-card .sub-info { display: flex; gap: 24px; margin-top: 12px; padding-top: 12px; border-top: 1px solid rgba(255,255,255,0.1); font-size: 14px; }
        .stats-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 20px; }
        .stat-item {
            background: white;
            padding: 16px;
            border-radius: 16px;
            text-align: center;
            box-shadow: 0 2px 8px rgba(0,0,0,0.06);
        }
        .stat-item .number { font-size: 24px; font-weight: 700; color: #1a1a2e; }
        .stat-item .label { font-size: 12px; color: #888; margin-top: 4px; }
        .section-title { font-size: 18px; font-weight: 700; color: #1a1a2e; margin: 20px 0 12px; }
        .nav-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 10px;
            margin-bottom: 20px;
        }
        .nav-item {
            background: white;
            padding: 16px 8px;
            border-radius: 16px;
            text-align: center;
            text-decoration: none;
            color: #1a1a2e;
            transition: 0.2s;
            box-shadow: 0 2px 8px rgba(0,0,0,0.06);
        }
        .nav-item:active { transform: scale(0.95); }
        .nav-item .icon { font-size: 28px; display: block; margin-bottom: 4px; }
        .nav-item .label { font-size: 12px; font-weight: 600; }
        .trade-list { background: white; border-radius: 16px; overflow: hidden; box-shadow: 0 2px 8px rgba(0,0,0,0.06); }
        .trade-item {
            padding: 12px 16px;
            border-bottom: 1px solid #f0f2f5;
            display: flex;
            justify-content: space-between;
            font-size: 14px;
        }
        .trade-item:last-child { border-bottom: none; }
        .trade-item .buy { color: #27ae60; font-weight: 600; }
        .trade-item .sell { color: #e74c3c; font-weight: 600; }
        .trade-item .time { color: #999; font-size: 12px; }
        .empty { text-align: center; color: #999; padding: 30px 0; }
        .bottom-nav {
            position: fixed;
            bottom: 0;
            left: 0;
            right: 0;
            background: white;
            display: flex;
            justify-content: space-around;
            padding: 8px 0;
            border-top: 1px solid #e8ecf1;
            max-width: 480px;
            margin: 0 auto;
        }
        .bottom-nav a {
            text-decoration: none;
            color: #888;
            font-size: 12px;
            text-align: center;
            padding: 4px 0;
            flex: 1;
        }
        .bottom-nav a .icon { font-size: 22px; display: block; }
        .bottom-nav a.active { color: #667eea; }
    </style>
</head>
<body>
    <header class="header">
        <h2>🚀 数字货币</h2>
        <div class="user-info">
            <span><%= user.username %></span>
            <div class="avatar"><%= user.username.charAt(0).toUpperCase() %></div>
            <a href="/logout" class="logout">退出</a>
        </div>
    </header>

    <div class="container">
        <div class="balance-card">
            <div class="label">总资产 (USDT)</div>
            <div class="amount"><%= balance.toFixed(2) %></div>
            <div class="sub-info">
                <span>💳 可提现: <%= balance.toFixed(2) %></span>
                <span>🔒 冻结: 0.00</span>
            </div>
        </div>

        <div class="stats-grid">
            <div class="stat-item">
                <div class="number"><%= totalDeposits.toFixed(2) %></div>
                <div class="label">累计充值</div>
            </div>
            <div class="stat-item">
                <div class="number"><%= totalWithdraws.toFixed(2) %></div>
                <div class="label">累计取款</div>
            </div>
        </div>

        <div class="nav-grid">
            <a href="/trade" class="nav-item">
                <span class="icon">📈</span>
                <span class="label">交易</span>
            </a>
            <a href="/deposit" class="nav-item">
                <span class="icon">💰</span>
                <span class="label">充值</span>
            </a>
            <a href="/withdraw" class="nav-item">
                <span class="icon">🏦</span>
                <span class="label">取款</span>
            </a>
            <a href="/settings" class="nav-item">
                <span class="icon">⚙️</span>
                <span class="label">设置</span>
            </a>
        </div>

        <div class="section-title">📊 最近交易</div>
        <div class="trade-list">
            <% if (recentTrades && recentTrades.length > 0) { %>
                <% recentTrades.forEach(trade => { %>
                    <div class="trade-item">
                        <span class="<%= trade.type %>"><%= trade.type === 'buy' ? '买入' : '卖出' %></span>
                        <span><%= trade.symbol %></span>
                        <span><%= trade.amount %> @ <%= trade.price %></span>
                        <span class="time"><%= new Date(trade.created_at).toLocaleString() %></span>
                    </div>
                <% }) %>
            <% } else { %>
                <div class="empty">暂无交易记录</div>
            <% } %>
        </div>
    </div>

    <div class="bottom-nav">
        <a href="/dashboard" class="active">
            <span class="icon">🏠</span>
            首页
        </a>
        <a href="/trade">
            <span class="icon">📈</span>
            交易
        </a>
        <a href="/deposit">
            <span class="icon">💰</span>
            充值
        </a>
        <a href="/withdraw">
            <span class="icon">🏦</span>
            取款
        </a>
        <a href="/settings">
            <span class="icon">⚙️</span>
            设置
        </a>
    </div>
</body>
</html>