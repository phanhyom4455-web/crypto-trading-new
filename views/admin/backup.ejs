<%- include('../includes/admin-header') %>
<div class="container-fluid main-content">
    <div class="top-bar d-flex justify-content-between align-items-center">
        <h4><i class="fas fa-database me-2 text-primary"></i>数据备份</h4>
        <div>
            <button class="btn btn-success"><i class="fas fa-plus me-1"></i>立即备份</button>
            <button class="btn btn-outline-secondary"><i class="fas fa-sync me-1"></i>刷新</button>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card bg-info text-white p-2">
                <div class="card-body"><h6>备份总数</h6><h3>24</h3></div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-success text-white p-2">
                <div class="card-body"><h6>总大小</h6><h3>15.6 GB</h3></div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-warning text-white p-2">
                <div class="card-body"><h6>最新备份</h6><h3>今天</h3></div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-danger text-white p-2">
                <div class="card-body"><h6>需要清理</h6><h3>3</h3></div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <table class="table table-hover">
                <thead><tr><th>备份名称</th><th>类型</th><th>大小</th><th>状态</th><th>时间</th><th>操作</th></tr></thead>
                <tbody>
                    <% backups.forEach(b => { %>
                    <tr>
                        <td><%= b.name %></td>
                        <td><span class="badge bg-<%= b.type === 'full' ? 'danger' : 'info' %>"><%= b.type %></span></td>
                        <td><%= b.size %></td>
                        <td><span class="badge bg-success"><%= b.status %></span></td>
                        <td><%= b.time %></td>
                        <td>
                            <button class="btn btn-sm btn-outline-primary">下载</button>
                            <button class="btn btn-sm btn-outline-danger">删除</button>
                        </td>
                    </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </div>
</div>
<script src="https://cdn.bootcdn.net/ajax/libs/twitter-bootstrap/5.3.0/js/bootstrap.bundle.min.js"></script>
</body>
</html> 
