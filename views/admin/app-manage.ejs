<%- include('../includes/admin-header') %>
<div class="container-fluid main-content">
    <div class="top-bar d-flex justify-content-between align-items-center">
        <h4><i class="fas fa-mobile-alt me-2 text-primary"></i>App管理</h4>
        <button class="btn btn-primary"><i class="fas fa-upload me-1"></i>上传版本</button>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card bg-success text-white p-2">
                <div class="card-body"><h6>总下载</h6><h3>15,842</h3></div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card bg-info text-white p-2">
                <div class="card-body"><h6>最新版本</h6><h3>v2.0.0</h3></div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card bg-warning text-white p-2">
                <div class="card-body"><h6>活跃设备</h6><h3>3,256</h3></div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <table class="table table-hover">
                <thead><tr><th>版本</th><th>平台</th><th>状态</th><th>发布日期</th><th>下载量</th><th>操作</th></tr></thead>
                <tbody>
                    <% versions.forEach(v => { %>
                    <tr>
                        <td><strong>v<%= v.version %></strong></td>
                        <td><span class="badge bg-<%= v.platform === 'iOS' ? 'secondary' : 'success' %>"><%= v.platform %></span></td>
                        <td><span class="badge bg-<%= v.status === 'latest' ? 'success' : 'secondary' %>"><%= v.status %></span></td>
                        <td><%= v.release_date %></td>
                        <td><%= v.downloads %></td>
                        <td>
                            <button class="btn btn-sm btn-outline-primary">下载</button>
                            <button class="btn btn-sm btn-outline-danger">删除</button>
                        </td>
                    </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </div>
</div>
<script src="https://cdn.bootcdn.net/ajax/libs/twitter-bootstrap/5.3.0/js/bootstrap.bundle.min.js"></script>
</body>
</html> 
