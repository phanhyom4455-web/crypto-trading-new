<%- include('../includes/admin-header') %>
<div class="container-fluid">
    <div class="row">
        <%- include('../includes/admin-sidebar') %>
        <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4">
            <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
                <h1 class="h2"><i class="fas fa-user-shield me-2"></i>用户安全设置管理</h1>
            </div>

            <!-- 搜索 -->
            <div class="card mb-3">
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <input type="text" class="form-control" id="searchUser" placeholder="搜索用户名..." onkeyup="searchUsers()">
                        </div>
                        <div class="col-md-2">
                            <button class="btn btn-primary w-100" onclick="searchUsers()"><i class="fas fa-search"></i> 搜索</button>
                        </div>
                        <div class="col-md-2">
                            <button class="btn btn-secondary w-100" onclick="resetSearch()"><i class="fas fa-undo"></i> 重置</button>
                        </div>
                        <div class="col-md-2">
                            <button class="btn btn-success w-100" onclick="loadUsers()"><i class="fas fa-sync"></i> 刷新</button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 用户列表 -->
            <div class="card">
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>用户名</th>
                                    <th>邮箱</th>
                                    <th>资金密码</th>
                                    <th>谷歌验证器(2FA)</th>
                                    <th>操作</th>
                                </tr>
                            </thead>
                            <tbody id="userList">
                                <tr>
                                    <td colspan="6" class="text-center text-muted py-4">
                                        <i class="fas fa-spinner fa-spin"></i> 加载中...
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </main>
    </div>
</div>

<!-- 重置弹窗 -->
<div class="modal fade" id="resetModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="fas fa-exclamation-triangle text-warning me-2"></i>确认重置</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div id="resetMsg" style="display: none;" class="alert"></div>
                <p>确定要重置 <strong id="resetUsername"></strong> 的 <strong id="resetType"></strong> 吗？</p>
                <p class="text-danger"><i class="fas fa-info-circle me-2"></i>此操作不可撤销！</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">取消</button>
                <button type="button" class="btn btn-danger" onclick="confirmReset()">确认重置</button>
            </div>
        </div>
    </div>
</div>

<script>
    let allUsers = [];
    let resetUserId = null;
    let resetType = '';

    // 加载用户列表
    async function loadUsers() {
        try {
            const response = await fetch('/api/users');
            const data = await response.json();
            allUsers = data;
            renderUsers(allUsers);
        } catch (error) {
            document.getElementById('userList').innerHTML = `
                <tr><td colspan="6" class="text-center text-danger py-4">加载失败，请刷新重试</td></tr>
            `;
        }
    }

    // 渲染用户列表
    function renderUsers(users) {
        const tbody = document.getElementById('userList');
        if (!users || users.length === 0) {
            tbody.innerHTML = `<tr><td colspan="6" class="text-center text-muted py-4">暂无用户</td></tr>`;
            return;
        }

        let html = '';
        users.forEach(user => {
            const fundStatus = user.fund_password_enabled ? 
                '<span class="badge bg-success">已设置</span>' : 
                '<span class="badge bg-secondary">未设置</span>';
            const twofaStatus = user.google_enabled ? 
                '<span class="badge bg-success">已启用</span>' : 
                '<span class="badge bg-secondary">未启用</span>';
            
            html += `
                <tr>
                    <td>${user.id}</td>
                    <td><strong>${user.username}</strong></td>
                    <td>${user.email || '-'}</td>
                    <td>${fundStatus}</td>
                    <td>${twofaStatus}</td>
                    <td>
                        <button class="btn btn-sm btn-outline-danger" onclick="showResetModal(${user.id}, '${user.username}', 'fund_password')">
                            <i class="fas fa-key"></i> 重置资金密码
                        </button>
                        <button class="btn btn-sm btn-outline-danger" onclick="showResetModal(${user.id}, '${user.username}', '2fa')">
                            <i class="fas fa-google"></i> 重置2FA
                        </button>
                    </td>
                </tr>
            `;
        });
        tbody.innerHTML = html;
    }

    // 搜索用户
    function searchUsers() {
        const keyword = document.getElementById('searchUser').value.toLowerCase().trim();
        if (!keyword) {
            renderUsers(allUsers);
            return;
        }
        const filtered = allUsers.filter(user => 
            user.username.toLowerCase().includes(keyword) ||
            (user.email && user.email.toLowerCase().includes(keyword))
        );
        renderUsers(filtered);
    }

    function resetSearch() {
        document.getElementById('searchUser').value = '';
        renderUsers(allUsers);
    }

    // 显示重置弹窗
    function showResetModal(userId, username, type) {
        resetUserId = userId;
        resetType = type;
        document.getElementById('resetUsername').textContent = username;
        var typeName = type === 'fund_password' ? '资金密码' : '谷歌验证器(2FA)';
        document.getElementById('resetType').textContent = typeName;
        document.getElementById('resetMsg').style.display = 'none';
        var modal = new bootstrap.Modal(document.getElementById('resetModal'));
        modal.show();
    }

    // 确认重置
    async function confirmReset() {
        try {
            const response = await fetch('/api/admin/reset-security', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    user_id: resetUserId,
                    type: resetType
                })
            });
            const data = await response.json();
            
            if (data.success) {
                document.getElementById('resetMsg').style.display = 'block';
                document.getElementById('resetMsg').textContent = '✅ ' + data.message;
                document.getElementById('resetMsg').className = 'alert alert-success';
                setTimeout(() => {
                    var modal = bootstrap.Modal.getInstance(document.getElementById('resetModal'));
                    modal.hide();
                    loadUsers();
                }, 1500);
            } else {
                document.getElementById('resetMsg').style.display = 'block';
                document.getElementById('resetMsg').textContent = '❌ ' + data.message;
                document.getElementById('resetMsg').className = 'alert alert-danger';
            }
        } catch (error) {
            document.getElementById('resetMsg').style.display = 'block';
            document.getElementById('resetMsg').textContent = '❌ 操作失败，请重试';
            document.getElementById('resetMsg').className = 'alert alert-danger';
        }
    }

    document.addEventListener('DOMContentLoaded', loadUsers);
</script>
<!-- 添加 Bootstrap JS -->
<script src="https://cdn.bootcdn.net/ajax/libs/twitter-bootstrap/5.3.0/js/bootstrap.bundle.min.js"></script>
</body>
</html>