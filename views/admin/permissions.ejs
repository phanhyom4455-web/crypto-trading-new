<%- include('../includes/admin-header') %>
<div class="container-fluid main-content">
    <div class="top-bar d-flex justify-content-between align-items-center">
        <h4><i class="fas fa-lock me-2 text-primary"></i>权限管理</h4>
        <button class="btn btn-primary"><i class="fas fa-plus me-1"></i>添加角色</button>
    </div>

    <div class="row">
        <% roles.forEach(role => { %>
        <div class="col-md-4 mb-4">
            <div class="card">
                <div class="card-body">
                    <h5><%= role.name %></h5>
                    <p>用户数: <strong><%= role.users %></strong></p>
                    <p>权限: 
                        <% if (role.permissions.includes('all')) { %>
                            <span class="badge bg-danger">所有权限</span>
                        <% } else { %>
                            <% role.permissions.forEach(p => { %>
                                <span class="badge bg-info"><%= p %></span>
                            <% }) %>
                        <% } %>
                    </p>
                    <button class="btn btn-sm btn-outline-primary">编辑</button>
                    <button class="btn btn-sm btn-outline-danger">删除</button>
                </div>
            </div>
        </div>
        <% }) %>
    </div>
</div>
<script src="https://cdn.bootcdn.net/ajax/libs/twitter-bootstrap/5.3.0/js/bootstrap.bundle.min.js"></script>
</body>
</html> 
