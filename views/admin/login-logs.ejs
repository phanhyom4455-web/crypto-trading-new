<%- include('../includes/admin-header') %>
<div class="container-fluid main-content">
    <div class="top-bar d-flex justify-content-between align-items-center">
        <h4><i class="fas fa-history me-2 text-primary"></i>登录日志</h4>
        <div>
            <button class="btn btn-outline-secondary btn-sm">今日</button>
            <button class="btn btn-outline-secondary btn-sm active">本周</button>
            <button class="btn btn-outline-secondary btn-sm">本月</button>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr><th>ID</th><th>用户名</th><th>IP地址</th><th>设备</th><th>状态</th><th>时间</th></tr>
                    </thead>
                    <tbody>
                        <% logs.forEach(log => { %>
                        <tr>
                            <td><%= log.id %></td>
                            <td><strong><%= log.username %></strong></td>
                            <td><code><%= log.ip %></code></td>
                            <td><%= log.device %></td>
                            <td>
                                <span class="badge bg-<%= log.status === 'success' ? 'success' : 'danger' %>">
                                    <%= log.status === 'success' ? '成功' : '失败' %>
                                </span>
                            </td>
                            <td><%= log.time %></td>
                        </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
<script src="https://cdn.bootcdn.net/ajax/libs/twitter-bootstrap/5.3.0/js/bootstrap.bundle.min.js"></script>
</body>
</html> 
