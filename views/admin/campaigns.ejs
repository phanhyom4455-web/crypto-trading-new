<%- include('../includes/admin-header') %>
<div class="container-fluid main-content">
    <div class="top-bar d-flex justify-content-between align-items-center">
        <h4><i class="fas fa-gift me-2 text-primary"></i>营销活动</h4>
        <button class="btn btn-primary"><i class="fas fa-plus me-1"></i>创建活动</button>
    </div>

    <div class="row">
        <% campaigns.forEach(c => { %>
        <div class="col-md-4 mb-4">
            <div class="card">
                <div class="card-body">
                    <h5><%= c.name %></h5>
                    <p>类型: <span class="badge bg-info"><%= c.type %></span></p>
                    <p>状态: <span class="badge bg-<%= c.status === 'active' ? 'success' : 'secondary' %>"><%= c.status %></span></p>
                    <p>时间: <%= c.start %> ~ <%= c.end %></p>
                    <p>参与: <strong><%= c.participants %></strong> 人</p>
                    <button class="btn btn-sm btn-outline-primary">编辑</button>
                    <button class="btn btn-sm btn-outline-danger">删除</button>
                </div>
            </div>
        </div>
        <% }) %>
    </div>
</div>
<script src="https://cdn.bootcdn.net/ajax/libs/twitter-bootstrap/5.3.0/js/bootstrap.bundle.min.js"></script>
</body>
</html> 
