<%- include('../includes/admin-header') %>
<div class="container-fluid main-content">
    <div class="top-bar d-flex justify-content-between align-items-center">
        <h4><i class="fas fa-bell me-2 text-primary"></i>通知管理</h4>
        <button class="btn btn-primary"><i class="fas fa-plus me-1"></i>发送通知</button>
    </div>

    <div class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr><th>ID</th><th>标题</th><th>类型</th><th>范围</th><th>状态</th><th>时间</th><th>操作</th></tr>
                    </thead>
                    <tbody>
                        <% notifications.forEach(n => { %>
                        <tr>
                            <td><%= n.id %></td>
                            <td><%= n.title %></td>
                            <td><span class="badge bg-info"><%= n.type %></span></td>
                            <td><%= n.scope === 'all' ? '全部' : 'VIP' %></td>
                            <td><span class="badge bg-success"><%= n.status %></span></td>
                            <td><%= n.created_at %></td>
                            <td>
                                <button class="btn btn-sm btn-outline-primary">查看</button>
                                <button class="btn btn-sm btn-outline-danger">删除</button>
                            </td>
                        </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
<script src="https://cdn.bootcdn.net/ajax/libs/twitter-bootstrap/5.3.0/js/bootstrap.bundle.min.js"></script>
</body>
</html> 
