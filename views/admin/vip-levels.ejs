<%- include('../includes/admin-header') %>
<div class="container-fluid main-content">
    <div class="top-bar d-flex justify-content-between align-items-center">
        <h4><i class="fas fa-crown me-2 text-warning"></i>会员等级</h4>
        <button class="btn btn-warning"><i class="fas fa-plus me-1"></i>添加等级</button>
    </div>

    <div class="row">
        <% levels.forEach(level => { %>
        <div class="col-md-4 mb-4">
            <div class="card text-center">
                <div class="card-body">
                    <h2><%= level.level %></h2>
                    <h5><%= level.name %></h5>
                    <p class="text-muted">消费 ¥<%= level.min_spent %></p>
                    <p>折扣: <strong><%= level.discount %></strong></p>
                    <p><%= level.benefits %></p>
                    <button class="btn btn-sm btn-outline-primary">编辑</button>
                </div>
            </div>
        </div>
        <% }) %>
    </div>
</div>
<script src="https://cdn.bootcdn.net/ajax/libs/twitter-bootstrap/5.3.0/js/bootstrap.bundle.min.js"></script>
</body>
</html> 
