<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>修改密码 - 管理后台</title>
    <link href="https://cdn.bootcdn.net/ajax/libs/twitter-bootstrap/5.3.0/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.bootcdn.net/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <style>
        body { background: #f0f2f5; padding: 30px; }
        .card { border-radius: 16px; border: none; box-shadow: 0 4px 20px rgba(0,0,0,0.08); }
        .card-header { background: #fff; border-bottom: 1px solid #f0f2f5; border-radius: 16px 16px 0 0 !important; padding: 20px 25px; }
        .card-body { padding: 30px 25px; }
        .form-control { border-radius: 8px; padding: 10px 16px; border: 2px solid #e5e7eb; }
        .form-control:focus { border-color: #667eea; box-shadow: 0 0 0 3px rgba(102,126,234,0.2); }
        .btn-primary { background: linear-gradient(135deg, #667eea, #764ba2); border: none; border-radius: 8px; padding: 10px 30px; font-weight: 600; }
        .btn-primary:hover { transform: translateY(-2px); box-shadow: 0 6px 20px rgba(102,126,234,0.4); }
        .alert { border-radius: 8px; }
    </style>
</head>
<body>

<div class="container" style="max-width: 600px;">
    <div class="card">
        <div class="card-header">
            <h5 class="mb-0"><i class="fas fa-key text-warning me-2"></i>修改管理员密码</h5>
        </div>
        <div class="card-body">
            <div id="msg" style="display: none;" class="alert"></div>

            <div class="mb-3">
                <label class="fw-bold">原密码</label>
                <input type="password" class="form-control" id="oldPassword" placeholder="请输入当前登录密码">
            </div>

            <div class="mb-3">
                <label class="fw-bold">新密码</label>
                <input type="password" class="form-control" id="newPassword" placeholder="请输入新密码（至少6位）">
            </div>

            <div class="mb-3">
                <label class="fw-bold">确认新密码</label>
                <input type="password" class="form-control" id="newPasswordConfirm" placeholder="请再次输入新密码">
            </div>

            <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                <a href="/admin/dashboard" class="btn btn-secondary" style="border-radius:8px; padding:10px 25px;">返回</a>
                <button class="btn btn-primary" onclick="submitChange()">确认修改</button>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.bootcdn.net/ajax/libs/twitter-bootstrap/5.3.0/js/bootstrap.bundle.min.js"></script>
<script>
    function showMsg(type, text) {
        var msg = document.getElementById('msg');
        msg.style.display = 'block';
        msg.className = 'alert alert-' + (type === 'success' ? 'success' : 'danger');
        msg.textContent = text;
    }

    async function submitChange() {
        var oldPwd = document.getElementById('oldPassword').value;
        var newPwd = document.getElementById('newPassword').value;
        var confirmPwd = document.getElementById('newPasswordConfirm').value;

        if (!oldPwd) {
            showMsg('error', '❌ 请输入原密码');
            return;
        }
        if (!newPwd || newPwd.length < 6) {
            showMsg('error', '❌ 新密码至少6个字符');
            return;
        }
        if (newPwd !== confirmPwd) {
            showMsg('error', '❌ 两次输入的新密码不一致');
            return;
        }

        try {
            var res = await fetch('/api/admin/change-password', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ oldPassword: oldPwd, newPassword: newPwd })
            });
            var data = await res.json();

            if (data.success) {
    showMsg('success', '✅ 密码修改成功！3 秒后自动退出，请用新密码登录');
    setTimeout(function() {
        window.location.href = '/admin/logout';
    }, 3000);
} else {
    showMsg('error', '❌ ' + data.message);
}
        } catch (e) {
            showMsg('error', '❌ 网络错误，请重试');
        }
    }
</script>
</body>
</html>