<%- include('../includes/admin-header') %>
<div class="container-fluid main-content">
    <div class="top-bar d-flex justify-content-between align-items-center">
        <h4><i class="fas fa-coins me-2 text-success"></i>财务统计</h4>
        <div>
            <button class="btn btn-outline-secondary btn-sm">今日</button>
            <button class="btn btn-outline-secondary btn-sm active">本月</button>
            <button class="btn btn-outline-secondary btn-sm">今年</button>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-md-3">
            <div class="card bg-primary text-white p-3">
                <div class="card-body">
                    <h6>总交易额</h6>
                    <h2>¥<%= stats.total_revenue.toFixed(2) %></h2>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-success text-white p-3">
                <div class="card-body">
                    <h6>总订单</h6>
                    <h2><%= stats.total_orders %></h2>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-danger text-white p-3">
                <div class="card-body">
                    <h6>退款金额</h6>
                    <h2>¥<%= stats.total_refund.toFixed(2) %></h2>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-info text-white p-3">
                <div class="card-body">
                    <h6>净利润</h6>
                    <h2>¥<%= stats.net_profit.toFixed(2) %></h2>
                </div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-header">财务趋势</div>
        <div class="card-body text-center py-5">
            <i class="fas fa-chart-line fa-4x text-muted"></i>
            <p class="mt-3">图表功能开发中...</p>
        </div>
    </div>
</div>
<script src="https://cdn.bootcdn.net/ajax/libs/twitter-bootstrap/5.3.0/js/bootstrap.bundle.min.js"></script>
</body>
</html> 
