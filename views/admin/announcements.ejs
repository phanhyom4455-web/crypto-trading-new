<%- include('../includes/admin-header') %>
<div class="container-fluid main-content">
    <div class="top-bar d-flex justify-content-between align-items-center">
        <h4><i class="fas fa-bullhorn me-2 text-primary"></i>公告管理</h4>
        <button class="btn btn-primary"><i class="fas fa-plus me-1"></i>发布公告</button>
    </div>

    <div class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr><th>ID</th><th>标题</th><th>类型</th><th>状态</th><th>时间</th><th>操作</th></tr>
                    </thead>
                    <tbody>
                        <% announcements.forEach(a => { %>
                        <tr>
                            <td><%= a.id %></td>
                            <td><%= a.title %></td>
                            <td>
                                <span class="badge bg-<%= a.type === 'maintenance' ? 'danger' : a.type === 'system' ? 'info' : 'success' %>">
                                    <%= a.type %>
                                </span>
                            </td>
                            <td>
                                <span class="badge bg-<%= a.status === 'published' ? 'success' : 'secondary' %>">
                                    <%= a.status === 'published' ? '已发布' : '草稿' %>
                                </span>
                            </td>
                            <td><%= a.time %></td>
                            <td>
                                <button class="btn btn-sm btn-outline-primary">编辑</button>
                                <button class="btn btn-sm btn-outline-danger">删除</button>
                            </td>
                        </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
<script src="https://cdn.bootcdn.net/ajax/libs/twitter-bootstrap/5.3.0/js/bootstrap.bundle.min.js"></script>
</body>
</html> 
