<%- include('../includes/admin-header') %>
<div class="container-fluid main-content">
    <div class="top-bar d-flex justify-content-between align-items-center">
        <h4><i class="fas fa-cog me-2 text-primary"></i>系统设置</h4>
        <button class="btn btn-primary"><i class="fas fa-save me-1"></i>保存设置</button>
    </div>

    <div class="row">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">基本设置</div>
                <div class="card-body">
                    <div class="mb-3">
                        <label>网站名称</label>
                        <input type="text" class="form-control" value="<%= settings.site_name %>">
                    </div>
                    <div class="mb-3">
                        <label>网站地址</label>
                        <input type="text" class="form-control" value="<%= settings.site_url %>">
                    </div>
                    <div class="form-check mb-3">
                        <input class="form-check-input" type="checkbox" <%= settings.maintenance ? 'checked' : '' %>>
                        <label>维护模式</label>
                    </div>
                    <div class="form-check mb-3">
                        <input class="form-check-input" type="checkbox" <%= settings.registration ? 'checked' : '' %>>
                        <label>允许注册</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" <%= settings.email_verify ? 'checked' : '' %>>
                        <label>邮箱验证</label>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">邮件设置</div>
                <div class="card-body">
                    <div class="mb-3">
                        <label>SMTP服务器</label>
                        <input type="text" class="form-control" value="<%= settings.smtp_host %>">
                    </div>
                    <div class="mb-3">
                        <label>端口</label>
                        <input type="number" class="form-control" value="<%= settings.smtp_port %>">
                    </div>
                    <div class="mb-3">
                        <label>用户名</label>
                        <input type="text" class="form-control" value="<%= settings.smtp_user %>">
                    </div>
                    <div class="mb-3">
                        <label>密码</label>
                        <input type="password" class="form-control" value="********">
                    </div>
                    <button class="btn btn-outline-secondary">测试连接</button>
                </div>
            </div>
        </div>
    </div>
</div>
<script src="https://cdn.bootcdn.net/ajax/libs/twitter-bootstrap/5.3.0/js/bootstrap.bundle.min.js"></script>
</body>
</html> 
