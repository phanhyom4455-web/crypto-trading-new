<%- include('../includes/admin-header') %>
<div class="container-fluid main-content">
    <div class="top-bar d-flex justify-content-between align-items-center">
        <h4><i class="fas fa-shield-alt me-2 text-danger"></i>风控管理</h4>
        <button class="btn btn-danger"><i class="fas fa-plus me-1"></i>添加规则</button>
    </div>

    <!-- 统计卡片 -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card bg-danger text-white p-2">
                <div class="card-body"><h6>高风险</h6><h3>3</h3></div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-warning text-white p-2">
                <div class="card-body"><h6>中风险</h6><h3>8</h3></div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-info text-white p-2">
                <div class="card-body"><h6>低风险</h6><h3>15</h3></div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-success text-white p-2">
                <div class="card-body"><h6>已处理</h6><h3>42</h3></div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-header">风控规则</div>
        <div class="card-body">
            <table class="table table-hover">
                <thead><tr><th>规则名称</th><th>触发条件</th><th>动作</th><th>优先级</th><th>状态</th><th>操作</th></tr></thead>
                <tbody>
                    <% rules.forEach(rule => { %>
                    <tr>
                        <td><%= rule.name %></td>
                        <td><%= rule.condition %></td>
                        <td><span class="badge bg-<%= rule.action === 'block' ? 'danger' : 'warning' %>"><%= rule.action %></span></td>
                        <td><%= rule.priority %></td>
                        <td><span class="badge bg-<%= rule.enabled ? 'success' : 'secondary' %>"><%= rule.enabled ? '启用' : '禁用' %></span></td>
                        <td>
                            <button class="btn btn-sm btn-outline-primary">编辑</button>
                            <button class="btn btn-sm btn-outline-danger">删除</button>
                        </td>
                    </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </div>

    <div class="card mt-3">
        <div class="card-header">风险事件</div>
        <div class="card-body">
            <table class="table table-hover">
                <thead><tr><th>用户</th><th>事件类型</th><th>风险等级</th><th>状态</th><th>时间</th><th>操作</th></tr></thead>
                <tbody>
                    <% events.forEach(event => { %>
                    <tr>
                        <td><%= event.username %></td>
                        <td><%= event.type %></td>
                        <td><span class="badge bg-<%= event.risk_level === 'high' ? 'danger' : 'warning' %>"><%= event.risk_level %></span></td>
                        <td><span class="badge bg-<%= event.status === 'pending' ? 'warning' : 'success' %>"><%= event.status %></span></td>
                        <td><%= event.time %></td>
                        <td>
                            <button class="btn btn-sm btn-outline-success">处理</button>
                            <button class="btn btn-sm btn-outline-info">查看</button>
                        </td>
                    </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </div>
</div>
<script src="https://cdn.bootcdn.net/ajax/libs/twitter-bootstrap/5.3.0/js/bootstrap.bundle.min.js"></script>
</body>
</html> 
