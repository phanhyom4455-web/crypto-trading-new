<!-- ============================================ -->
<!-- 用户余额显示（可用 + 总资产，和前台一致） -->
<!-- ============================================ -->
<script>
(function() {
    async function loadUsersBalance() {
        try {
            const res = await fetch('/api/admin/users-with-balance');
            const data = await res.json();

            if (data.success && data.users) {
                const tbody = document.querySelector('.table tbody');
                if (!tbody) return;

                const rows = tbody.querySelectorAll('tr');
                rows.forEach(row => {
                    const idCell = row.querySelector('td:first-child');
                    if (!idCell) return;

                    const userId = parseInt(idCell.textContent.trim());
                    const user = data.users.find(u => u.id === userId);

                    if (user) {
                        const emailCell = row.querySelectorAll('td')[2];
                        if (emailCell) {
                            // ✅ 同时显示：可用 + 总资产
                            const balanceTd = document.createElement('td');
                            const available = (user.balance - user.frozen).toFixed(2);
                            const total = user.balance.toFixed(2);

                            balanceTd.innerHTML =
                                '<div style="font-size:12px;color:#666;">可用: <strong style="color:#10b981;">$' + available + '</strong></div>' +
                                '<div style="font-size:12px;color:#666;">总额: <strong style="color:#3b82f6;">$' + total + '</strong></div>';

                            // 悬停显示明细
                            const detailLines = user.assetsDetail
                                .filter(a => a.balance > 0)
                                .map(a => a.currency + ': 可用' + a.balance + ' × $' + a.price + ' = $' + a.value.toFixed(2));
                            balanceTd.title = '资产明细：\n' + detailLines.join('\n');

                            emailCell.parentNode.insertBefore(balanceTd, emailCell.nextSibling);
                        }
                    }
                });
            }
        } catch (e) {
            console.log('加载用户余额失败', e);
        }
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', loadUsersBalance);
    } else {
        loadUsersBalance();
    }
})();
</script>