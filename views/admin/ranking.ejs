<%- include('../includes/admin-header') %>
<div class="container-fluid main-content">
    <div class="top-bar d-flex justify-content-between align-items-center">
        <h4><i class="fas fa-trophy me-2 text-warning"></i>用户排行</h4>
        <div>
            <button class="btn btn-outline-secondary btn-sm">收益排行</button>
            <button class="btn btn-outline-secondary btn-sm active">订单排行</button>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr><th>排名</th><th>用户</th><th>积分</th><th>订单数</th><th>消费金额</th></tr>
                    </thead>
                    <tbody>
                        <% ranking.forEach((user, index) => { %>
                        <tr>
                            <td>
                                <% if (index === 0) { %>🥇
                                <% } else if (index === 1) { %>🥈
                                <% } else if (index === 2) { %>🥉
                                <% } else { %><%= index + 1 %><% } %>
                            </td>
                            <td><strong><%= user.username %></strong></td>
                            <td><%= user.points %></td>
                            <td><%= user.orders %></td>
                            <td>¥<%= user.spent.toFixed(2) %></td>
                        </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
<script src="https://cdn.bootcdn.net/ajax/libs/twitter-bootstrap/5.3.0/js/bootstrap.bundle.min.js"></script>
</body>
</html> 
