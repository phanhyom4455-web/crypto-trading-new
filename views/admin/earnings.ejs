<%- include('../includes/admin-header') %>
<div class="container-fluid main-content">
    <div class="top-bar d-flex justify-content-between align-items-center">
        <h4><i class="fas fa-chart-bar me-2 text-primary"></i>收益统计</h4>
        <button class="btn btn-success"><i class="fas fa-file-export me-1"></i>导出报表</button>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-md-3">
            <div class="card bg-success text-white p-3">
                <div class="card-body"><h6>今日收益</h6><h2>¥<%= stats.today.toFixed(2) %></h2></div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-primary text-white p-3">
                <div class="card-body"><h6>本周收益</h6><h2>¥<%= stats.week.toFixed(2) %></h2></div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-info text-white p-3">
                <div class="card-body"><h6>本月收益</h6><h2>¥<%= stats.month.toFixed(2) %></h2></div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-warning text-white p-3">
                <div class="card-body"><h6>总收益</h6><h2>¥<%= stats.total.toFixed(2) %></h2></div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-header">收益趋势</div>
        <div class="card-body text-center py-5">
            <i class="fas fa-chart-area fa-4x text-muted"></i>
            <p class="mt-3">收益图表展示</p>
        </div>
    </div>
</div>
<script src="https://cdn.bootcdn.net/ajax/libs/twitter-bootstrap/5.3.0/js/bootstrap.bundle.min.js"></script>
</body>
</html> 
