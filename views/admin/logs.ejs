<%- include('../includes/admin-header') %>
<div class="container-fluid main-content">
    <div class="top-bar d-flex justify-content-between align-items-center">
        <h4><i class="fas fa-clipboard-list me-2 text-primary"></i>操作日志</h4>
        <div>
            <button class="btn btn-outline-secondary btn-sm"><i class="fas fa-filter"></i> 筛选</button>
            <button class="btn btn-outline-secondary btn-sm"><i class="fas fa-download"></i> 导出</button>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <table class="table table-hover">
                <thead><tr><th>ID</th><th>操作人</th><th>操作</th><th>目标</th><th>IP</th><th>时间</th></tr></thead>
                <tbody>
                    <% logs.forEach(log => { %>
                    <tr>
                        <td><%= log.id %></td>
                        <td><strong><%= log.operator %></strong></td>
                        <td><%= log.action %></td>
                        <td><%= log.target %></td>
                        <td><code><%= log.ip %></code></td>
                        <td><%= log.time %></td>
                    </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </div>
</div>
<script src="https://cdn.bootcdn.net/ajax/libs/twitter-bootstrap/5.3.0/js/bootstrap.bundle.min.js"></script>
</body>
</html> 
