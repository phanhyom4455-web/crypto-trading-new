<%- include('../includes/admin-header') %>
<div class="container-fluid main-content">
    <div class="top-bar d-flex justify-content-between align-items-center">
        <h4><i class="fas fa-<%= icon || 'cog' %> me-2 text-primary"></i><%= title %></h4>
        <span class="text-muted"><%= new Date().toLocaleString('zh-CN') %></span>
    </div>

    <div class="card">
        <div class="card-body text-center py-5">
            <i class="fas fa-<%= icon || 'cog' %> fa-4x text-muted mb-3"></i>
            <h4><%= title %></h4>
            <p class="text-muted">此页面功能开发中，敬请期待...</p>
            <div class="mt-3">
                <button class="btn btn-primary"><i class="fas fa-plus me-1"></i>新增</button>
                <button class="btn btn-outline-secondary"><i class="fas fa-search me-1"></i>搜索</button>
            </div>
        </div>
    </div>
</div>
<script src="https://cdn.bootcdn.net/ajax/libs/twitter-bootstrap/5.3.0/js/bootstrap.bundle.min.js"></script>
</body>
</html>