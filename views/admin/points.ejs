<%- include('../includes/admin-header') %>
<div class="container-fluid main-content">
    <div class="top-bar d-flex justify-content-between align-items-center">
        <h4><i class="fas fa-star me-2 text-warning"></i>积分管理</h4>
        <button class="btn btn-warning"><i class="fas fa-plus me-1"></i>添加规则</button>
    </div>

    <div class="row">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">积分规则</div>
                <div class="card-body">
                    <table class="table">
                        <thead><tr><th>规则</th><th>积分</th><th>类型</th><th>状态</th></tr></thead>
                        <tbody>
                            <% rules.forEach(rule => { %>
                            <tr>
                                <td><%= rule.name %></td>
                                <td><%= rule.points %></td>
                                <td><%= rule.type %></td>
                                <td><span class="badge bg-<%= rule.status === 'active' ? 'success' : 'danger' %>"><%= rule.status %></span></td>
                            </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">积分兑换</div>
                <div class="card-body">
                    <div class="list-group">
                        <div class="list-group-item d-flex justify-content-between">
                            <span>1000积分 = 10 USDT</span>
                            <button class="btn btn-sm btn-primary">兑换</button>
                        </div>
                        <div class="list-group-item d-flex justify-content-between">
                            <span>5000积分 = VIP周卡</span>
                            <button class="btn btn-sm btn-primary">兑换</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script src="https://cdn.bootcdn.net/ajax/libs/twitter-bootstrap/5.3.0/js/bootstrap.bundle.min.js"></script>
</body>
</html> 
