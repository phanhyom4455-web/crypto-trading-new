<%- include('../includes/admin-header') %>
<div class="container-fluid main-content">
    <div class="top-bar d-flex justify-content-between align-items-center">
        <h4><i class="fas fa-users me-2 text-primary"></i>用户管理</h4>
        <button class="btn btn-primary" onclick="addUser()"><i class="fas fa-plus me-1"></i>添加用户</button>
    </div>

    <div class="card">
        <div class="card-body">
            <div class="table-responsive">
            <!-- ✅ 搜索框 -->
            <div class="mb-3">
                <input type="text" id="shortIdSearch" class="form-control" placeholder="🔍 输入用户ID搜索（如 6845）" style="max-width: 300px;">
            </div>
                <table class="table table-hover">
                    <thead>
                            <tr>
                            <th>用户ID</th>
                            <th>用户名</th>
                            <th>邮箱</th>
                           <th>USDT余额</th>
                            <th>VIP</th>
                            <th>积分</th>
                            <th>订单数</th>
                            <th>消费金额</th>
                            <th>状态</th>
                            <th>操作</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% users.forEach(user => { %>
                             <tr>
                          
                            <td>
                                <span style="font-family: monospace; color:#667eea; font-weight: 600;">
                                    <%= String(user.short_id || '').padStart(4, '0') %>
                                </span>
                            </td>
                            <td><strong><%= user.username %></strong></td>
                            <td><%= user.email %></td>
                           <td>
    <div style="font-size:12px;color:#666;">可用: <strong style="color:#10b981;">$<%= (user.balance - user.frozen).toFixed(2) %></strong></div>
    <div style="font-size:12px;color:#666;">总额: <strong style="color:#3b82f6;">$<%= user.balance.toFixed(2) %></strong></div>
</td>
                            <td><%= user.vip ? '✅' : '❌' %></td>
                            <td><%= user.points %></td>
                            <td><%= user.orders %></td>
                            <td>¥<%= user.spent.toFixed(2) %></td>
                            <td>
                                <span class="badge bg-<%= user.status === 'active' ? 'success' : 'danger' %>">
                                    <%= user.status === 'active' ? '正常' : '禁用' %>
                                </span>
                            </td>
                            <td>
                                <td>
                                 <button class="btn btn-sm btn-outline-primary" onclick="editUser(<%= user.id %>)">编辑</button>
                                 <button class="btn btn-sm btn-outline-danger" onclick="deleteUser(<%= user.id %>)">删除</button>
                                <button class="btn btn-sm btn-outline-warning" onclick="resetPassword(<%= user.id %>, '<%= user.username %>')">重置密码</button>
                                <button class="btn btn-sm btn-outline-info" onclick="viewSecurity(<%= user.id %>, '<%= user.username %>')">安全设置</button>
                               <button class="btn btn-sm btn-outline-dark" onclick="deductBalance(<%= user.id %>, '<%= user.username %>')">扣除</button>
                              <button class="btn btn-sm btn-outline-success" onclick="addBalance(<%= user.id %>, '<%= user.username %>')">新增</button>
                             <button class="btn btn-sm btn-outline-<%= user.status === 'active' ? 'secondary' : 'success' %>" onclick="toggleUserStatus(<%= user.id %>, '<%= user.username %>')">
                           <%= user.status === 'active' ? '禁用' : '启用' %>
                    </button>
                  </td>
                            </td>
                        </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<script>
    // 编辑用户
    function editUser(userId) {
        const newUsername = prompt('请输入新的用户名：');
        if (newUsername) {
            alert('编辑功能即将上线！用户ID: ' + userId);
        }
    }
    
    // 删除用户
    async function deleteUser(userId) {
        if (confirm('确定要删除这个用户吗？此操作不可恢复！')) {
            try {
                const response = await fetch('/api/users/' + userId, {
                    method: 'DELETE'
                });
                
                const result = await response.json();
                
                if (result.success) {
                    alert('✅ 用户删除成功！');
                    location.reload(); // 刷新页面
                } else {
                    alert('❌ 删除失败：' + result.message);
                }
            } catch (error) {
                alert('❌ 删除失败，请检查网络');
            }
        }
    }
    
    // 添加用户
    async function addUser() {
        const username = prompt('请输入用户名：');
        if (!username) return;
        
        const email = prompt('请输入邮箱：');
        if (!email) return;
        
        const password = prompt('请输入密码（至少6位）：');
        if (!password || password.length < 6) {
            alert('密码至少6位');
            return;
        }
        
        try {
            const response = await fetch('/api/register', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    username: username,
                    email: email,
                    phone: '',
                    password: password
                })
            });
            
            const result = await response.json();
            
            if (result.success) {
                alert('✅ 用户添加成功！');
                location.reload(); // 刷新页面
            } else {
                alert('❌ 添加失败：' + result.message);
            }
        } catch (error) {
            alert('❌ 添加失败，请检查网络');
        }
    }
</script>
<%- include('includes/admin-users-actions') %>
<%- include('includes/admin-deduct') %>

<script>
    // ✅ 按 用户ID(short_id) 实时搜索
    document.addEventListener('DOMContentLoaded', function() {
        var searchInput = document.getElementById('shortIdSearch');
        if (!searchInput) return;

        searchInput.addEventListener('input', function() {
            var keyword = this.value.trim();
            var rows = document.querySelectorAll('table tbody tr');

            rows.forEach(function(row) {
                // 第 2 列是"用户ID"列（索引从 0 开始，所以是 [1]）
                var tds = row.querySelectorAll('td');
                if (tds.length < 2) {
                    row.style.display = 'none';
                    return;
                }
                var shortId = tds[0].textContent.trim();

                if (keyword === '' || shortId.indexOf(keyword) !== -1) {
                    row.style.display = '';
                } else {
                    row.style.display = 'none';
                }
            });
        });
    });
</script>
<script>
    // ✅ 切换用户状态（启用/禁用）
    function toggleUserStatus(userId, username) {
        const action = confirm('确定要切换用户 "' + username + '" 的状态吗？');
        if (!action) return;

        fetch('/api/admin/toggle-user-status', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ user_id: userId })
        })
        .then(r => r.json())
        .then(result => {
            alert(result.success ? result.message : '❌ ' + result.message);
            if (result.success) location.reload();
        })
        .catch(() => {
            alert('❌ 请求失败，请检查网络');
        });
    }
</script>
</body>
</html>