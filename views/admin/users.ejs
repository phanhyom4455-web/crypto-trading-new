<%- include('../includes/admin-header') %>
<div class="container-fluid main-content">
    <div class="top-bar d-flex justify-content-between align-items-center">
        <h4><i class="fas fa-users me-2 text-primary"></i>用户管理</h4>
        <button class="btn btn-primary" onclick="addUser()"><i class="fas fa-plus me-1"></i>添加用户</button>
    </div>

    <div class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>用户名</th>
                            <th>邮箱</th>
                           <th>USDT余额</th>
                            <th>VIP</th>
                            <th>积分</th>
                            <th>订单数</th>
                            <th>消费金额</th>
                            <th>状态</th>
                            <th>操作</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% users.forEach(user => { %>
                        <tr>
                            <td><%= user.id %></td>
                            <td><strong><%= user.username %></strong></td>
                            <td><%= user.email %></td>
                            <td><%= user.vip ? '✅' : '❌' %></td>
                            <td><%= user.points %></td>
                            <td><%= user.orders %></td>
                            <td>¥<%= user.spent.toFixed(2) %></td>
                            <td>
                                <span class="badge bg-<%= user.status === 'active' ? 'success' : 'danger' %>">
                                    <%= user.status === 'active' ? '正常' : '禁用' %>
                                </span>
                            </td>
                            <td>
                                <td>
                                 <button class="btn btn-sm btn-outline-primary" onclick="editUser(<%= user.id %>)">编辑</button>
                                 <button class="btn btn-sm btn-outline-danger" onclick="deleteUser(<%= user.id %>)">删除</button>
                                <button class="btn btn-sm btn-outline-warning" onclick="resetPassword(<%= user.id %>, '<%= user.username %>')">重置密码</button>
                                <button class="btn btn-sm btn-outline-info" onclick="viewSecurity(<%= user.id %>, '<%= user.username %>')">安全设置</button>
                               <button class="btn btn-sm btn-outline-dark" onclick="deductBalance(<%= user.id %>, '<%= user.username %>')">扣除</button>
                              <button class="btn btn-sm btn-outline-success" onclick="addBalance(<%= user.id %>, '<%= user.username %>')">新增</button>
</td>
                            </td>
                        </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<script>
    // 编辑用户
    function editUser(userId) {
        const newUsername = prompt('请输入新的用户名：');
        if (newUsername) {
            alert('编辑功能即将上线！用户ID: ' + userId);
        }
    }
    
    // 删除用户
    async function deleteUser(userId) {
        if (confirm('确定要删除这个用户吗？此操作不可恢复！')) {
            try {
                const response = await fetch('/api/users/' + userId, {
                    method: 'DELETE'
                });
                
                const result = await response.json();
                
                if (result.success) {
                    alert('✅ 用户删除成功！');
                    location.reload(); // 刷新页面
                } else {
                    alert('❌ 删除失败：' + result.message);
                }
            } catch (error) {
                alert('❌ 删除失败，请检查网络');
            }
        }
    }
    
    // 添加用户
    async function addUser() {
        const username = prompt('请输入用户名：');
        if (!username) return;
        
        const email = prompt('请输入邮箱：');
        if (!email) return;
        
        const password = prompt('请输入密码（至少6位）：');
        if (!password || password.length < 6) {
            alert('密码至少6位');
            return;
        }
        
        try {
            const response = await fetch('/api/register', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    username: username,
                    email: email,
                    phone: '',
                    password: password
                })
            });
            
            const result = await response.json();
            
            if (result.success) {
                alert('✅ 用户添加成功！');
                location.reload(); // 刷新页面
            } else {
                alert('❌ 添加失败：' + result.message);
            }
        } catch (error) {
            alert('❌ 添加失败，请检查网络');
        }
    }
</script>
<%- include('includes/admin-users-actions') %>
<%- include('includes/admin-deduct') %>
<%- include('includes/users-balance') %>
</body>
</html>