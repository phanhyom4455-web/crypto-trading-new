<%- include('../includes/admin-header') %>
<div class="container-fluid">
    <div class="row">
        <%- include('../includes/admin-sidebar') %>
        <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4">
            <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
                <h1 class="h2"><i class="fas fa-key me-2"></i>重置用户密码</h1>
            </div>

            <!-- 搜索用户 -->
            <div class="card mb-3">
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <input type="text" class="form-control" id="searchUser" placeholder="输入用户名或邮箱搜索..." onkeyup="searchUsers()">
                        </div>
                        <div class="col-md-2">
                            <button class="btn btn-primary w-100" onclick="searchUsers()"><i class="fas fa-search"></i> 搜索</button>
                        </div>
                        <div class="col-md-2">
                            <button class="btn btn-secondary w-100" onclick="resetSearch()"><i class="fas fa-undo"></i> 重置</button>
                        </div>
                        <div class="col-md-2">
                            <button class="btn btn-success w-100" onclick="loadUsers()"><i class="fas fa-sync"></i> 刷新</button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 用户列表 -->
            <div class="card">
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>用户名</th>
                                    <th>邮箱</th>
                                    <th>VIP</th>
                                    <th>状态</th>
                                    <th>操作</th>
                                </tr>
                            </thead>
                            <tbody id="userList">
                                <tr>
                                    <td colspan="6" class="text-center text-muted py-4">
                                        <i class="fas fa-spinner fa-spin"></i> 加载中...
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </main>
    </div>
</div>

<!-- 重置密码弹窗 -->
<div class="modal fade" id="resetPasswordModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="fas fa-key text-warning me-2"></i>重置密码</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div id="resetMsg" style="display: none;" class="alert"></div>
                <p>正在重置用户：<strong id="resetUsername"></strong></p>
                <div class="mb-3">
                    <label class="fw-bold">新密码</label>
                    <input type="password" class="form-control" id="newPassword" placeholder="请输入新密码（至少6位）" minlength="6">
                </div>
                <div class="mb-3">
                    <label class="fw-bold">确认密码</label>
                    <input type="password" class="form-control" id="confirmPassword" placeholder="请再次输入新密码">
                </div>
                <div class="alert alert-info">
                    <i class="fas fa-info-circle me-2"></i>
                    重置后用户将使用新密码登录，建议通知用户。
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">取消</button>
                <button type="button" class="btn btn-warning" onclick="confirmResetPassword()">
                    <i class="fas fa-key"></i> 确认重置
                </button>
            </div>
        </div>
    </div>
</div>

<script>
    let allUsers = [];
    let resetUserId = null;

    // 加载用户列表
    async function loadUsers() {
        try {
            const response = await fetch('/api/users');
            const data = await response.json();
            allUsers = data;
            renderUsers(allUsers);
        } catch (error) {
            document.getElementById('userList').innerHTML = `
                <tr><td colspan="6" class="text-center text-danger py-4">加载失败，请刷新重试</td></tr>
            `;
        }
    }

    // 渲染用户列表
    function renderUsers(users) {
        const tbody = document.getElementById('userList');
        if (!users || users.length === 0) {
            tbody.innerHTML = `<tr><td colspan="6" class="text-center text-muted py-4">暂无用户</td></tr>`;
            return;
        }

        let html = '';
        users.forEach(user => {
            const vipBadge = user.vip ? '<span class="badge bg-warning">VIP</span>' : '<span class="badge bg-secondary">普通</span>';
            const statusBadge = user.status === 'active' ? 
                '<span class="badge bg-success">正常</span>' : 
                '<span class="badge bg-danger">禁用</span>';
            
            html += `
                <tr>
                    <td>${user.id}</td>
                    <td><strong>${user.username}</strong></td>
                    <td>${user.email || '-'}</td>
                    <td>${vipBadge}</td>
                    <td>${statusBadge}</td>
                    <td>
                        <button class="btn btn-sm btn-warning" onclick="showResetModal(${user.id}, '${user.username}')">
                            <i class="fas fa-key"></i> 重置密码
                        </button>
                    </td>
                </tr>
            `;
        });
        tbody.innerHTML = html;
    }

    // 搜索用户
    function searchUsers() {
        const keyword = document.getElementById('searchUser').value.toLowerCase().trim();
        if (!keyword) {
            renderUsers(allUsers);
            return;
        }
        const filtered = allUsers.filter(user => 
            user.username.toLowerCase().includes(keyword) ||
            (user.email && user.email.toLowerCase().includes(keyword))
        );
        renderUsers(filtered);
    }

    function resetSearch() {
        document.getElementById('searchUser').value = '';
        renderUsers(allUsers);
    }

    // 显示重置弹窗
    function showResetModal(userId, username) {
        resetUserId = userId;
        document.getElementById('resetUsername').textContent = username;
        document.getElementById('newPassword').value = '';
        document.getElementById('confirmPassword').value = '';
        document.getElementById('resetMsg').style.display = 'none';
        // 使用 bootstrap 全局对象
        var modal = new bootstrap.Modal(document.getElementById('resetPasswordModal'));
        modal.show();
    }

    // 确认重置密码
    async function confirmResetPassword() {
        const newPassword = document.getElementById('newPassword').value;
        const confirmPassword = document.getElementById('confirmPassword').value;
        const msg = document.getElementById('resetMsg');

        if (newPassword.length < 6) {
            msg.style.display = 'block';
            msg.textContent = '❌ 密码至少6个字符';
            msg.className = 'alert alert-danger';
            return;
        }

        if (newPassword !== confirmPassword) {
            msg.style.display = 'block';
            msg.textContent = '❌ 两次密码不一致';
            msg.className = 'alert alert-danger';
            return;
        }

        try {
            const response = await fetch('/api/admin/reset-password', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    user_id: resetUserId,
                    password: newPassword
                })
            });
            const data = await response.json();

            if (data.success) {
                msg.style.display = 'block';
                msg.textContent = '✅ ' + data.message;
                msg.className = 'alert alert-success';
                setTimeout(() => {
                    var modal = bootstrap.Modal.getInstance(document.getElementById('resetPasswordModal'));
                    modal.hide();
                    loadUsers();
                }, 1500);
            } else {
                msg.style.display = 'block';
                msg.textContent = '❌ ' + data.message;
                msg.className = 'alert alert-danger';
            }
        } catch (error) {
            msg.style.display = 'block';
            msg.textContent = '❌ 操作失败，请重试';
            msg.className = 'alert alert-danger';
        }
    }

    document.addEventListener('DOMContentLoaded', loadUsers);
</script>
<!-- 添加 Bootstrap JS -->
<script src="https://cdn.bootcdn.net/ajax/libs/twitter-bootstrap/5.3.0/js/bootstrap.bundle.min.js"></script>
</body>
</html>