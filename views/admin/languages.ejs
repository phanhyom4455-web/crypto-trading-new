<%- include('../includes/admin-header') %>
<div class="container-fluid main-content">
    <div class="top-bar d-flex justify-content-between align-items-center">
        <h4><i class="fas fa-globe me-2 text-primary"></i>多语言管理</h4>
        <button class="btn btn-primary"><i class="fas fa-plus me-1"></i>添加语言</button>
    </div>

    <div class="row">
        <% languages.forEach(lang => { %>
        <div class="col-md-4 mb-4">
            <div class="card">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <h5><%= lang.name %></h5>
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" <%= lang.enabled ? 'checked' : '' %>>
                        </div>
                    </div>
                    <p>代码: <code><%= lang.code %></code></p>
                    <p>翻译进度: 
                        <div class="progress">
                            <div class="progress-bar bg-success" style="width: <%= lang.progress %>%"><%= lang.progress %>%</div>
                        </div>
                    </p>
                    <button class="btn btn-sm btn-outline-primary">翻译</button>
                    <button class="btn btn-sm btn-outline-danger">删除</button>
                </div>
            </div>
        </div>
        <% }) %>
    </div>
</div>
<script src="https://cdn.bootcdn.net/ajax/libs/twitter-bootstrap/5.3.0/js/bootstrap.bundle.min.js"></script>
</body>
</html> 
